@model RestaurantWebsite.Models.User

@{
    ViewBag.Title = "Tạo tài khoản nhân viên";
    Layout = "~/Views/Shared/_OperationsLayout.cshtml";
}

<div class="row">
    <div class="col-md-9 col-lg-7 mx-auto">
        <div class="card card-info">
            <div class="card-header">
                <h3 class="card-title"><i class="fa fa-user-plus mr-2"></i>Tạo tài khoản nhân viên</h3>
            </div>

            @using (Html.BeginForm("CreateStaff", "Users", new { area = "Admin" }, FormMethod.Post, new { @class = "form-horizontal" }))
            {
                @Html.AntiForgeryToken()

                <div class="card-body">
                    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                    <div class="form-group row">
                        <label for="FullName" class="col-sm-3 col-form-label font-weight-bold">Họ và tên <span class="text-danger">*</span></label>
                        <div class="col-sm-9">
                            @Html.TextBoxFor(m => m.FullName, new { @class = "form-control", placeholder = "Ví dụ: Nguyễn Văn An", required = "required" })
                            @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group row">
                        <label for="Email" class="col-sm-3 col-form-label font-weight-bold">Email <span class="text-danger">*</span></label>
                        <div class="col-sm-9">
                            @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email", placeholder = "staff@restaurant.com", required = "required" })
                            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group row">
                        <label for="password" class="col-sm-3 col-form-label font-weight-bold">Mật khẩu <span class="text-danger">*</span></label>
                        <div class="col-sm-9">
                            <input type="password" id="password" name="password" class="form-control" placeholder="Ít nhất 6 ký tự" minlength="6" required />
                            @Html.ValidationMessageFor(m => m.PasswordHash, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group row">
                        <label for="Phone" class="col-sm-3 col-form-label font-weight-bold">Số điện thoại</label>
                        <div class="col-sm-9">
                            @Html.TextBoxFor(m => m.Phone, new { @class = "form-control", placeholder = "0901234567" })
                            @Html.ValidationMessageFor(m => m.Phone, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group row">
                        <label for="Address" class="col-sm-3 col-form-label font-weight-bold">Địa chỉ</label>
                        <div class="col-sm-9">
                            @Html.TextAreaFor(m => m.Address, new { @class = "form-control", rows = 2, placeholder = "Địa chỉ của nhân viên..." })
                            @Html.ValidationMessageFor(m => m.Address, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group row">
                        <label class="col-sm-3 col-form-label font-weight-bold">Vai trò được giao</label>
                        <div class="col-sm-9">
                            <input type="text" class="form-control-plaintext font-weight-bold text-info" value="Nhân viên" readonly />
                            <small class="form-text text-muted">Tài khoản mới có quyền nhân viên để truy cập khu vực làm việc.</small>
                        </div>
                    </div>

                    <div class="form-group row">
                        <div class="col-sm-9 offset-sm-3">
                            <div class="custom-control custom-checkbox">
                                @Html.CheckBoxFor(m => m.IsActive, new { @class = "custom-control-input", id = "IsActive" })
                                <label class="custom-control-label font-weight-bold" for="IsActive">Kích hoạt tài khoản ngay</label>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card-footer text-right">
                    <a href="@Url.Action("Index", "Users", new { area = "Admin" })" class="btn btn-default mr-2">
                        <i class="fa fa-arrow-left mr-1"></i> Hủy
                    </a>
                    <button type="submit" class="btn btn-info">
                        <i class="fa fa-user-plus mr-1"></i> Tạo tài khoản nhân viên
                    </button>
                </div>
            }
        </div>
    </div>
</div>
