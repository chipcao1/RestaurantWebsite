@model RestaurantWebsite.Models.User
@{
    ViewBag.Title = "Chi tiết tài khoản #" + Model.Id;
    Layout = "~/Views/Shared/_OperationsLayout.cshtml";
    bool isSelf = Model.Id == (ViewBag.CurrentAdminId != null ? (int)ViewBag.CurrentAdminId : 0);
}
<div class="page-heading">
    <div><h1>Chi tiết tài khoản</h1><p>Xem thông tin và quản lý quyền truy cập của tài khoản.</p></div>
    <a href="@Url.Action("Index", "Users", new { area = "Admin" })" class="btn btn-outline-secondary"><i class="fa fa-arrow-left mr-1"></i>Danh sách tài khoản</a>
</div>
<div class="row">
    <div class="col-lg-7">
        <div class="card card-primary card-outline">
            <div class="card-header"><h2 class="card-title"><i class="fa fa-user mr-2"></i>@Model.FullName</h2></div>
            <div class="card-body">
                <dl class="row account-details mb-0">
                    <dt class="col-sm-4">Họ và tên</dt><dd class="col-sm-8">@Model.FullName</dd>
                    <dt class="col-sm-4">Email</dt><dd class="col-sm-8">@Model.Email</dd>
                    <dt class="col-sm-4">Điện thoại</dt><dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Phone) ? "Chưa cập nhật" : Model.Phone)</dd>
                    <dt class="col-sm-4">Địa chỉ</dt><dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Address) ? "Chưa cập nhật" : Model.Address)</dd>
                    <dt class="col-sm-4">Vai trò</dt><dd class="col-sm-8">@Vietnamese.Label(Model.Role)</dd>
                    <dt class="col-sm-4">Trạng thái</dt><dd class="col-sm-8"><span class="badge @(Model.IsActive ? "badge-success" : "badge-secondary")">@(Model.IsActive ? "Đang hoạt động" : "Đã khóa")</span></dd>
                    <dt class="col-sm-4">Ngày đăng ký</dt><dd class="col-sm-8">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</dd>
                </dl>
            </div>
        </div>
        <div class="card card-outline card-secondary">
            <div class="card-header"><h2 class="card-title">Thống kê hoạt động</h2></div>
            <ul class="list-group list-group-flush">
                <li class="list-group-item d-flex justify-content-between"><span>Đơn đã đặt</span><strong>@Model.Orders.Count</strong></li>
                <li class="list-group-item d-flex justify-content-between"><span>Lượt đặt bàn</span><strong>@Model.Reservations.Count</strong></li>
                <li class="list-group-item d-flex justify-content-between"><span>Đánh giá món</span><strong>@Model.Reviews.Count</strong></li>
            </ul>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card card-outline card-warning">
            <div class="card-header"><h2 class="card-title"><i class="fa fa-lock mr-2"></i>Truy cập tài khoản</h2></div>
            <div class="card-body">
                @if (isSelf)
                {
                    <p class="text-muted">Đây là tài khoản bạn đang sử dụng. Bạn không thể tự khóa tài khoản này.</p>
                }
                else
                {
                    <p>@(Model.IsActive ? "Khóa tài khoản sẽ ngăn người dùng truy cập các chức năng yêu cầu đăng nhập." : "Mở khóa để người dùng tiếp tục đăng nhập và sử dụng tài khoản.")</p>
                    using (Html.BeginForm("ToggleStatus", "Users", new { area = "Admin", id = Model.Id }, FormMethod.Post, new { onsubmit = "return confirm('Bạn xác nhận thay đổi trạng thái truy cập tài khoản này?');" }))
                    {
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn @(Model.IsActive ? "btn-warning" : "btn-success") btn-block">@(Model.IsActive ? "Khóa tài khoản" : "Mở khóa tài khoản")</button>
                    }
                }
            </div>
        </div>
        <div class="card card-outline card-danger">
            <div class="card-header"><h2 class="card-title"><i class="fa fa-key mr-2"></i>Đặt lại mật khẩu</h2></div>
            <div class="card-body">
                <p>Đặt lại mật khẩu của tài khoản về <strong>123456789</strong>. Người dùng có thể đăng nhập bằng mật khẩu này sau khi đặt lại.</p>
                @using (Html.BeginForm("ResetPassword", "Users", new { area = "Admin", id = Model.Id }, FormMethod.Post, new { onsubmit = "return confirm('Đặt lại mật khẩu tài khoản này về 123456789?');" }))
                {
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger btn-block">Đặt lại về 123456789</button>
                }
            </div>
        </div>
    </div>
</div>
