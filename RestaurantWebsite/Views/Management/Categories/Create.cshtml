@{ Layout = "~/Views/Shared/_OperationsLayout.cshtml"; }
@model RestaurantWebsite.Models.Category
@{
    Layout = "~/Views/Shared/_OperationsLayout.cshtml";
    ViewBag.Title = "Thêm danh mục mới";
}

<div class="row justify-content-center">
    <div class="col-lg-8 col-md-10 col-12">
        <div class="card card-primary card-outline shadow-sm">
            <div class="card-header">
                <h3 class="card-title font-weight-bold">
                    <i class="fa fa-plus-circle text-primary mr-1"></i> Tạo danh mục món
                </h3>
                <div class="card-tools">
                    <a href="@Url.Action("Index", "Categories", new { area = Convert.ToString(ViewContext.RouteData.DataTokens["area"]) })" class="btn btn-outline-secondary btn-sm">
                        <i class="fa fa-arrow-left mr-1"></i> Về danh sách
                    </a>
                </div>
            </div>

            @using (Html.BeginForm("Create", "Categories", new { area = Convert.ToString(ViewContext.RouteData.DataTokens["area"]) }, FormMethod.Post, new { @class = "form-horizontal" }))
            {
                @Html.AntiForgeryToken()

                <div class="card-body">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <h5><i class="fa fa-exclamation-triangle mr-2"></i> Vui lòng kiểm tra lại các thông tin sau:</h5>
                            @Html.ValidationSummary(false, "", new { @class = "mb-0 pl-3 text-white" })
                            <button type="button" class="close" data-dismiss="alert" aria-label="Đóng">
                                <span aria-hidden="true">&times;</span>
                            </button>
                        </div>
                    }

                    <!-- Tên danh mục -->
                    <div class="form-group row">
                        <label for="Name" class="col-sm-3 col-form-label font-weight-bold">
                            Tên danh mục <span class="text-danger">*</span>
                        </label>
                        <div class="col-sm-9">
                            @Html.TextBoxFor(m => m.Name, new {
                                @class = "form-control",
                                placeholder = "Ví dụ: Khai vị, Món chính, Đồ uống, Tráng miệng...",
                                autofocus = "autofocus",
                                maxlength = "100",
                                required = "required"
                            })
                            @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger small" })
                            <small class="form-text text-muted">Tên danh mục rõ ràng, không trùng, tối đa 100 ký tự.</small>
                        </div>
                    </div>

                    <!-- Mô tả -->
                    <div class="form-group row">
                        <label for="Description" class="col-sm-3 col-form-label font-weight-bold">
                            Mô tả
                        </label>
                        <div class="col-sm-9">
                            @Html.TextAreaFor(m => m.Description, new {
                                @class = "form-control",
                                rows = "3",
                                placeholder = "Mô tả ngắn các món trong danh mục...",
                                maxlength = "500"
                            })
                            @Html.ValidationMessageFor(m => m.Description, "", new { @class = "text-danger small" })
                            <small class="form-text text-muted">Mô tả hiển thị trên thực đơn, tối đa 500 ký tự.</small>
                        </div>
                    </div>

                    <!-- Image URL -->
                    <div class="form-group row">
                        <label for="ImageUrl" class="col-sm-3 col-form-label font-weight-bold">
                            Đường dẫn ảnh
                        </label>
                        <div class="col-sm-9">
                            @Html.TextBoxFor(m => m.ImageUrl, new {
                                @class = "form-control",
                                id = "categoryImageUrl",
                                placeholder = "Ví dụ: https://...",
                                maxlength = "250"
                            })
                            @Html.ValidationMessageFor(m => m.ImageUrl, "", new { @class = "text-danger small" })
                            <small class="form-text text-muted">Đường dẫn nội bộ (ví dụ: <code>/Content/images/categories/...</code>) hoặc địa chỉ HTTPS.</small>

                            <!-- Live preview block -->
                            <div class="mt-2 d-flex align-items-center" id="imagePreviewContainer">
                                <span class="mr-2 small text-muted">Xem trước:</span>
                                <img data-food-image id="previewImg"
                                     src="@Url.Content("~/Resources/Admin/img/default-150x150.png")"
                                     alt="Xem trước"
                                     class="img-thumbnail rounded"
                                     style="width: 60px; height: 60px; object-fit: cover;" />
                            </div>
                        </div>
                    </div>

                    <!-- IsActive -->
                    <div class="form-group row align-items-center">
                        <label class="col-sm-3 col-form-label font-weight-bold">
                            Trạng thái ban đầu
                        </label>
                        <div class="col-sm-9">
                            <div class="custom-control custom-checkbox">
                                @Html.CheckBoxFor(m => m.IsActive, new { @class = "custom-control-input", id = "isActiveCheck" })
                                <label class="custom-control-label font-weight-normal" for="isActiveCheck">
                                    <strong>Đang hoạt động</strong> (Danh mục và món đang bán sẽ hiển thị ngay trên thực đơn)
                                </label>
                            </div>
                        </div>
                    </div>

                </div>

                <div class="card-footer bg-light d-flex justify-content-between">
                    <a href="@Url.Action("Index", "Categories", new { area = Convert.ToString(ViewContext.RouteData.DataTokens["area"]) })" class="btn btn-default">
                        <i class="fa fa-times mr-1"></i> Hủy
                    </a>
                    <button type="submit" class="btn btn-success font-weight-bold px-4">
                        <i class="fa fa-save mr-1"></i> Lưu danh mục
                    </button>
                </div>
            }
        </div>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function () {
            var $imgInput = $('#categoryImageUrl');
            var $preview = $('#previewImg');

            function updatePreview() {
                var val = $imgInput.val().trim();
                if (val) {
                    $preview.attr('src', val);
                } else {
                    $preview.attr('src', '@Url.Content("~/Resources/Admin/img/default-150x150.png")');
                }
            }

            $imgInput.on('input change blur', updatePreview);
            updatePreview();
        });
    </script>
}
