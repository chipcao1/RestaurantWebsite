@model RestaurantWebsite.Models.Order

@{
    ViewBag.Title = "Order Details #" + Model.Id;
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var validOrderStatuses = ViewBag.ValidOrderStatuses as string[] ?? new string[0];
    var validPaymentStatuses = ViewBag.ValidPaymentStatuses as string[] ?? new string[0];
    var latestPayment = Model.Payments?.OrderByDescending(p => p.Id).FirstOrDefault();
    var promoInfo = Model.OrderPromotions?.FirstOrDefault();
}

<div class="row">
    <!-- Left Column: Items, Customer, Delivery & Promotion details -->
    <div class="col-lg-8">
        <!-- Order Header & Customer Card -->
        <div class="card card-primary">
            <div class="card-header">
                <h3 class="card-title"><i class="fa fa-shopping-cart mr-2"></i>Order Invoice #@Model.Id</h3>
                <div class="card-tools">
                    <a href="@Url.Action("Receipt", "Order", new { area = "", id = Model.Id })" target="_blank" class="btn btn-tool text-white" title="Print Receipt">
                        <i class="fa fa-print mr-1"></i> Print Receipt
                    </a>
                    <span class="badge badge-light px-2 py-1 font-weight-bold">Type: @Model.OrderType</span>
                </div>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-sm-6">
                        <h6 class="text-uppercase text-muted font-weight-bold">Customer Information</h6>
                        <p class="mb-1"><strong>Name:</strong> @(Model.User != null ? Model.User.FullName : "Guest Customer")</p>
                        <p class="mb-1"><strong>Email:</strong> @(Model.User != null ? Model.User.Email : "N/A")</p>
                        <p class="mb-1"><strong>Phone:</strong> <span class="text-primary font-weight-bold">@(Model.Phone ?? "N/A")</span></p>
                        @if (!string.IsNullOrEmpty(Model.DeliveryAddress))
                        {
                            <p class="mb-0"><strong>Delivery Address:</strong> @Model.DeliveryAddress</p>
                        }
                    </div>
                    <div class="col-sm-6">
                        <h6 class="text-uppercase text-muted font-weight-bold">Order Metadata</h6>
                        <p class="mb-1"><strong>Placed At:</strong> @Model.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</p>
                        <p class="mb-1"><strong>Current Status:</strong> <span class="badge badge-info px-2 py-1">@Model.Status</span></p>
                        @if (Model.ReservationId.HasValue)
                        {
                            <p class="mb-1"><strong>Linked Reservation:</strong> <a href="@Url.Action("Details", "Reservations", new { area = "Admin", id = Model.ReservationId.Value })">#@Model.ReservationId.Value</a></p>
                        }
                        @if (Model.TableId.HasValue && Model.Table != null)
                        {
                            <p class="mb-0"><strong>Assigned Table:</strong> Table @Model.Table.TableNumber (@Model.Table.Zone)</p>
                        }
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Model.Note))
                {
                    <div class="alert alert-secondary py-2">
                        <i class="fa fa-comment-o mr-2"></i><strong>Customer Note:</strong> "@Model.Note"
                    </div>
                }

                <hr />

                <!-- Order Items Table -->
                <h6 class="text-uppercase text-muted font-weight-bold mb-3">Order Items</h6>
                <div class="table-responsive">
                    <table class="table table-bordered table-striped align-middle">
                        <thead class="thead-light">
                            <tr>
                                <th>Item Name</th>
                                <th class="text-center">Type</th>
                                <th class="text-right">Unit Price</th>
                                <th class="text-center">Quantity</th>
                                <th class="text-right">Subtotal</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.OrderItems)
                            {
                                <tr>
                                    <td>
                                        @if (item.Dish != null)
                                        {
                                            <span class="font-weight-bold"><i class="fa fa-cutlery text-warning mr-1"></i>@item.Dish.Name</span>
                                        }
                                        else if (item.Combo != null)
                                        {
                                            <span class="font-weight-bold text-success"><i class="fa fa-cubes mr-1"></i>@item.Combo.Name (Combo)</span>
                                        }
                                        else
                                        {
                                            <span class="font-weight-bold text-muted">Unknown Item</span>
                                        }

                                        @if (!string.IsNullOrEmpty(item.Note))
                                        {
                                            <small class="d-block text-muted">Note: @item.Note</small>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <span class="badge badge-light border">@(item.DishId.HasValue ? "Dish" : "Combo")</span>
                                    </td>
                                    <td class="text-right">$@item.UnitPrice.ToString("N2")</td>
                                    <td class="text-center font-weight-bold">@item.Quantity</td>
                                    <td class="text-right font-weight-bold">$@item.SubTotal.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <th colspan="4" class="text-right">SubTotal:</th>
                                <td class="text-right font-weight-bold">$@Model.SubTotal.ToString("N2")</td>
                            </tr>

                            @if (Model.DiscountAmount > 0)
                            {
                                <tr class="text-danger">
                                    <th colspan="4" class="text-right">
                                        Discount
                                        @if (promoInfo != null && promoInfo.Promotion != null)
                                        {
                                            <span>(Code: <strong>@promoInfo.Promotion.Code</strong> - @promoInfo.Promotion.Name)</span>
                                        }
                                        :
                                    </th>
                                    <td class="text-right font-weight-bold">-$@Model.DiscountAmount.ToString("N2")</td>
                                </tr>
                            }

                            @if (Model.DeliveryFee > 0)
                            {
                                <tr>
                                    <th colspan="4" class="text-right">Delivery Fee:</th>
                                    <td class="text-right font-weight-bold">+$@Model.DeliveryFee.ToString("N2")</td>
                                </tr>
                            }

                            <tr class="bg-light">
                                <th colspan="4" class="text-right font-size-18 text-primary">Grand Total:</th>
                                <td class="text-right font-size-18 text-primary font-weight-bold">$@Model.TotalAmount.ToString("N2")</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
            <div class="card-footer">
                <a href="@Url.Action("Index", "Orders", new { area = "Admin" })" class="btn btn-default">
                    <i class="fa fa-arrow-left mr-1"></i> Back to Orders List
                </a>
            </div>
        </div>
    </div>

    <!-- Right Column: Status & Payment Controls -->
    <div class="col-lg-4">

        <!-- Order Status Control Card -->
        <div class="card card-outline card-primary">
            <div class="card-header">
                <h3 class="card-title font-weight-bold"><i class="fa fa-truck text-primary mr-2"></i>Order Status</h3>
            </div>
            <div class="card-body">
                <p class="text-muted mb-2">Current Order Status: <strong class="text-dark">@Model.Status</strong></p>

                @using (Html.BeginForm("UpdateStatus", "Orders", new { area = "Admin" }, FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.Hidden("id", Model.Id)

                    <div class="form-group mb-3">
                        <label class="font-weight-bold">Update Order Status:</label>
                        <select name="newStatus" class="form-control" required>
                            @foreach (var st in validOrderStatuses)
                            {
                                <option value="@st" @(st == Model.Status ? "selected" : "")>@st</option>
                            }
                        </select>
                    </div>

                    <button type="submit" class="btn btn-primary btn-block">
                        <i class="fa fa-save mr-1"></i> Save Order Status
                    </button>
                }
            </div>
        </div>

        <!-- Payment Info & Control Card -->
        <div class="card card-outline card-success">
            <div class="card-header">
                <h3 class="card-title font-weight-bold"><i class="fa fa-money text-success mr-2"></i>Payment Details</h3>
            </div>
            <div class="card-body">
                @if (latestPayment == null)
                {
                    <div class="alert alert-warning mb-0">
                        <i class="fa fa-warning mr-1"></i> No payment transaction found for this order.
                    </div>
                }
                else
                {
                    <ul class="list-group list-group-unbordered mb-3">
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span>Payment Method</span>
                            <strong class="text-primary">@latestPayment.PaymentMethod</strong>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span>Payment Amount</span>
                            <strong class="text-success">$@latestPayment.Amount.ToString("N2")</strong>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span>Current Status</span>
                            @if (latestPayment.Status == "Completed")
                            {
                                <span class="badge badge-success px-2 py-1"><i class="fa fa-check mr-1"></i>Completed (Paid)</span>
                            }
                            else if (latestPayment.Status == "Pending")
                            {
                                <span class="badge badge-warning text-dark px-2 py-1"><i class="fa fa-clock-o mr-1"></i>Pending</span>
                            }
                            else
                            {
                                <span class="badge badge-secondary px-2 py-1">@latestPayment.Status</span>
                            }
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span>Payment Date</span>
                            <small class="text-muted">@latestPayment.PaymentDate.ToString("yyyy-MM-dd HH:mm")</small>
                        </li>
                        @if (!string.IsNullOrEmpty(latestPayment.TransactionCode))
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <span>Transaction Code</span>
                                <small class="font-weight-bold">@latestPayment.TransactionCode</small>
                            </li>
                        }
                    </ul>

                    using (Html.BeginForm("UpdatePaymentStatus", "Orders", new { area = "Admin" }, FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        @Html.Hidden("paymentId", latestPayment.Id)

                        <div class="form-group mb-3">
                            <label class="font-weight-bold">Update Payment Status:</label>
                            <select name="newPaymentStatus" class="form-control" required>
                                @foreach (var pst in validPaymentStatuses)
                                {
                                    <option value="@pst" @(pst == latestPayment.Status ? "selected" : "")>@pst</option>
                                }
                            </select>
                        </div>

                        <button type="submit" class="btn btn-success btn-block">
                            <i class="fa fa-check-square-o mr-1"></i> Save Payment Status
                        </button>
                    }
                }
            </div>
        </div>

    </div>
</div>
