@{
    ViewBag.Title = "About Us";
    ViewBag.BodyClass = "sub_page";
}

<!-- ================================================= -->
<!-- ABOUT PROJECT -->
<!-- ================================================= -->

<section class="about_section layout_padding">

    <div class="container">

        <div class="row align-items-center">

            <div class="col-md-6">

                <div class="img-box">

                    <img src="@Url.Content("~/Resources/User/images/about-img.png")"
                         alt="Restaurant Management System" />

                </div>

            </div>


            <div class="col-md-6">

                <div class="detail-box">

                    <div class="heading_container">

                        <h2>
                            About Our Project
                        </h2>

                    </div>

                    <p>
                        Our project is a Web Application
                        for Restaurant and Food Order Management.
                        The system is developed to support
                        restaurant operations and improve
                        the customer dining experience.
                    </p>

                    <p>
                        Customers can browse food categories,
                        view dishes and combos, place online
                        delivery orders, and reserve tables
                        through the website.
                    </p>

                    <p>
                        The system also provides management
                        functions for restaurant staff and
                        administrators to manage orders,
                        tables, menu information, accounts,
                        promotions, and reports.
                    </p>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- ================================================= -->
<!-- SYSTEM OBJECTIVES -->
<!-- ================================================= -->

<section class="about_section layout_padding-bottom">

    <div class="container">

        <div class="heading_container heading_center">

            <h2>
                Project Objectives
            </h2>

        </div>

        <div class="row mt-4">

            <div class="col-md-4">

                <div class="box text-center p-4">

                    <h4>
                        Convenient Ordering
                    </h4>

                    <p>
                        Provide customers with a simple
                        way to browse the menu and place
                        online delivery orders.
                    </p>

                </div>

            </div>


            <div class="col-md-4">

                <div class="box text-center p-4">

                    <h4>
                        Table Reservation
                    </h4>

                    <p>
                        Allow customers to select an
                        available table and reserve it
                        for their visit.
                    </p>

                </div>

            </div>


            <div class="col-md-4">

                <div class="box text-center p-4">

                    <h4>
                        Restaurant Management
                    </h4>

                    <p>
                        Support staff and administrators
                        in managing restaurant operations
                        efficiently.
                    </p>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- ================================================= -->
<!-- MAIN FEATURES -->
<!-- ================================================= -->

<section class="about_section layout_padding-bottom">

    <div class="container">

        <div class="heading_container heading_center">

            <h2>
                Main Features
            </h2>

        </div>

        <div class="row mt-4">

            <div class="col-md-6">

                <ul class="list-unstyled">

                    <li class="mb-3">
                        <i class="fa fa-check mr-2"></i>
                        Browse food categories and menu items
                    </li>

                    <li class="mb-3">
                        <i class="fa fa-check mr-2"></i>
                        View dish and combo details
                    </li>

                    <li class="mb-3">
                        <i class="fa fa-check mr-2"></i>
                        Add dishes and combos to cart
                    </li>

                    <li class="mb-3">
                        <i class="fa fa-check mr-2"></i>
                        Place online delivery orders
                    </li>

                </ul>

            </div>


            <div class="col-md-6">

                <ul class="list-unstyled">

                    <li class="mb-3">
                        <i class="fa fa-check mr-2"></i>
                        Reserve restaurant tables
                    </li>

                    <li class="mb-3">
                        <i class="fa fa-check mr-2"></i>
                        Manage customer accounts
                    </li>

                    <li class="mb-3">
                        <i class="fa fa-check mr-2"></i>
                        Manage restaurant orders and tables
                    </li>

                    <li class="mb-3">
                        <i class="fa fa-check mr-2"></i>
                        Generate management reports
                    </li>

                </ul>

            </div>

        </div>

    </div>

</section>


<!-- ================================================= -->
<!-- USER ROLES -->
<!-- ================================================= -->

<section class="about_section layout_padding-bottom">

    <div class="container">

        <div class="heading_container heading_center">

            <h2>
                User Roles
            </h2>

        </div>

        <div class="row mt-4">

            <div class="col-md-4">

                <div class="box text-center p-4">

                    <h4>
                        Customer
                    </h4>

                    <p>
                        Browse menu, order food,
                        reserve tables and manage
                        personal activities.
                    </p>

                </div>

            </div>


            <div class="col-md-4">

                <div class="box text-center p-4">

                    <h4>
                        Restaurant Staff
                    </h4>

                    <p>
                        Process orders, manage tables
                        and support daily restaurant
                        operations.
                    </p>

                </div>

            </div>


            <div class="col-md-4">

                <div class="box text-center p-4">

                    <h4>
                        Administrator
                    </h4>

                    <p>
                        Manage accounts, menu categories,
                        promotions and business reports.
                    </p>

                </div>

            </div>

        </div>

    </div>

</section>