@using System.Linq
@model RestaurantWebsite.Models.Dish

@{
    Layout = null;

    RestaurantWebsite.Models.DishImage primaryImage = null;

    if (Model != null &&
        Model.DishImages != null &&
        Model.DishImages.Any())
    {
        primaryImage =
            Model.DishImages.FirstOrDefault(i => i.IsPrimary)
            ?? Model.DishImages.FirstOrDefault();
    }

    bool isLoggedIn = Session["UserId"] != null;
}


@if (Model == null)
{
    <div class="text-center p-4">
        <p class="text-danger">
            Dish information cannot be found.
        </p>
    </div>
}
else
{
    <div class="row">

        <!-- ================================================= -->
        <!-- DISH IMAGE -->
        <!-- ================================================= -->

        <div class="col-md-6">

            <div class="img-box text-center p-2 bg-light rounded">

                @if (primaryImage != null &&
                     !string.IsNullOrEmpty(primaryImage.ImageUrl))
                {
                    <img src="@Url.Content(primaryImage.ImageUrl)"
                         id="mainModalImg"
                         alt="@Model.Name"
                         class="img-fluid rounded"
                         style="max-height:300px;width:100%;object-fit:cover;" />
                }
                else
                {
                    <img src="@Url.Content("~/Resources/User/images/f1.png")"
                         id="mainModalImg"
                         alt="Default Image"
                         class="img-fluid rounded"
                         style="max-height:300px;width:100%;object-fit:cover;" />
                }

            </div>


            <!-- OTHER IMAGES -->
            @if (Model.DishImages != null &&
                 Model.DishImages.Count() > 1)
            {
                <div class="row mt-2 justify-content-center">

                    @foreach (var img in Model.DishImages)
                    {
                        if (!string.IsNullOrEmpty(img.ImageUrl))
                        {
                            <div class="col-3 p-1">

                                <img src="@Url.Content(img.ImageUrl)"
                                     class="img-thumbnail"
                                     style="height:50px;width:100%;object-fit:cover;cursor:pointer;"
                                     onclick="document.getElementById('mainModalImg').src=this.src"
                                     alt="@Model.Name" />

                            </div>
                        }
                    }

                </div>
            }

        </div>


        <!-- ================================================= -->
        <!-- DISH INFORMATION -->
        <!-- ================================================= -->

        <div class="col-md-6">

            <div class="detail-box pl-md-2">

                <h3 class="text-dark font-weight-bold">
                    @Model.Name
                </h3>


                <h4 class="text-danger font-weight-bold my-3">
                    @Model.Price.ToString("N0") VND
                </h4>


                <p class="text-secondary"
                   style="font-size:14px;max-height:100px;overflow-y:auto;">

                    @(
                        !string.IsNullOrEmpty(Model.Description)
                            ? Model.Description
                            : "No description available."
                    )

                </p>


                <!-- ATTRIBUTES -->
                <div class="attributes mt-3"
                     style="font-size:14px;">

                    <p class="mb-1">


                        Loại:

                        <span class="badge badge-info">

                            @(
                                Model.Category != null
                                    ? Model.Category.Name
                                    : "General"
                            )

                        </span>

                    </p>


                    <p class="mb-1">

                        Thời gian chuẩn bị:

                        <strong>
                            @Model.PreparationTime mins
                        </strong>

                    </p>


                    <p class="mb-3">

                            Tình trạng:

                        @if (Model.Status == "Available")
                        {
                            <span class="text-success font-weight-bold">
                                ● Còn bán 
                            </span>
                        }
                        else
                        {
                            <span class="text-muted">
                                ● Hết hàng
                            </span>
                        }

                    </p>

                </div>


                <!-- ================================================= -->
                <!-- ACTION -->
                <!-- ================================================= -->

                @if (Model.Status == "Available")
                {

                    if (isLoggedIn)
                    {
                        using (Html.BeginForm(
                            "AddToCart",
                            "Menu",
                            FormMethod.Post))
                        {
                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="id"
                                   value="@Model.Id" />

                            <!-- QUANTITY -->
                            <div class="form-group mb-3">

                                <label class="text-secondary d-block mb-2">
                                    Số lượng:
                                </label>

                                <div class="d-flex align-items-center"
                                     style="max-width:220px;">

                                    <!-- MINUS -->
                                    <button type="button"
                                            class="btn btn-outline-secondary d-flex align-items-center justify-content-center"
                                            style="width:48px;height:48px;font-size:24px;font-weight:bold;padding:0;"
                                            onclick="
                                            var input=document.getElementById('txtQuantity');
                                            var value=parseInt(input.value, 10) || 1;
                                            if (value>
                                        1) {
                                        input.value = value - 1;
                                        }
                                        "
                                        aria-label="Decrease quantity">

                                        −

                                    </button>


                                    <!-- QUANTITY DISPLAY -->
                                    <input type="text"
                                           id="txtQuantity"
                                           name="quantity"
                                           value="1"
                                           readonly
                                           class="form-control text-center mx-2"
                                           style="width:80px;height:48px;font-size:18px;font-weight:bold;background:#fff;"
                                           aria-label="Quantity" />


                                    <!-- PLUS -->
                                    <button type="button"
                                            class="btn btn-outline-secondary d-flex align-items-center justify-content-center"
                                            style="width:48px;height:48px;font-size:24px;font-weight:bold;padding:0;"
                                            onclick="
                                            var input=document.getElementById('txtQuantity');
                                            var value=parseInt(input.value, 10) || 1;
                                            if (value < 100) {
                                                    input.value = value + 1;
                                                }
                                            "
                                            aria-label="Increase quantity">

                                        +

                                    </button>

                                </div>

                            </div>


                            <!-- ADD TO CART -->
                            <button type="submit"
                                    class="btn btn-warning btn-block text-white font-weight-bold py-2 shadow-sm">

                                <i class="fa fa-shopping-cart"></i>

                                Add to Cart

                            </button>
                        }
                    }
                    else
                    {
                        <!-- QUANTITY -->
                        <div class="form-group mb-3">

                            <label class="text-secondary d-block mb-2">
                                Quantity:
                            </label>

                            <div class="d-flex align-items-center"
                                 style="max-width:220px;">

                                <!-- MINUS -->
                                <button type="button"
                                        class="btn btn-outline-secondary d-flex align-items-center justify-content-center"
                                        style="width:48px;height:48px;font-size:24px;font-weight:bold;padding:0;"
                                        onclick="
                                        var input=document.getElementById('txtQuantity');
                                        var value=parseInt(input.value, 10) || 1;
                                        if (value>
                                    1) {
                                    input.value = value - 1;
                                    }
                                    "
                                    aria-label="Decrease quantity">

                                    −

                                </button>


                                <!-- QUANTITY DISPLAY -->
                                <input type="text"
                                       id="txtQuantity"
                                       value="1"
                                       readonly
                                       class="form-control text-center mx-2"
                                       style="width:80px;height:48px;font-size:18px;font-weight:bold;background:#fff;"
                                       aria-label="Quantity" />


                                <!-- PLUS -->
                                <button type="button"
                                        class="btn btn-outline-secondary d-flex align-items-center justify-content-center"
                                        style="width:48px;height:48px;font-size:24px;font-weight:bold;padding:0;"
                                        onclick="
                                        var input=document.getElementById('txtQuantity');
                                        var value=parseInt(input.value, 10) || 1;
                                        if (value < 100) {
                                                input.value = value + 1;
                                            }
                                        "
                                        aria-label="Increase quantity">

                                    +

                                </button>

                            </div>

                        </div>


                        <!-- LOGIN -->
                        <a href="@Url.Action(
                                    "Login",
                                    "Account",
                                    new
                                    {
                                        returnUrl = Url.Action(
                                            "Index",
                                            "Menu")
                                    })"
                           class="btn btn-warning btn-block text-white font-weight-bold py-2 shadow-sm">

                            <i class="fa fa-sign-in"></i>

                            Login to Order

                        </a>
                    }

                }
                else
                {
                    <button type="button"
                            class="btn btn-secondary btn-block py-2"
                            disabled>

                        Temporarily Unavailable

                    </button>
                }

            </div>

        </div>

    </div>
}