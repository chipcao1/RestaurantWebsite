@{ Layout = "~/Views/Shared/_OperationsLayout.cshtml"; }
@model IEnumerable<RestaurantWebsite.Models.Category>
@{
    Layout = "~/Views/Shared/_OperationsLayout.cshtml";
    ViewBag.Title = "Danh mục món ăn";

    int activeCount = Model != null ? Model.Count(c => c.IsActive) : 0;
    int inactiveCount = Model != null ? Model.Count(c => !c.IsActive) : 0;
    int totalCount = Model != null ? Model.Count() : 0;
}

<!-- Summary stats header -->
<div class="row mb-3">
    <div class="col-md-4 col-sm-6 col-12">
        <div class="info-box shadow-sm mb-2">
            <span class="info-box-icon bg-info"><i class="fa fa-th-list"></i></span>
            <div class="info-box-content">
                <span class="info-box-text">Tổng danh mục</span>
                <span class="info-box-number font-weight-bold">@totalCount</span>
            </div>
        </div>
    </div>
    <div class="col-md-4 col-sm-6 col-12">
        <div class="info-box shadow-sm mb-2">
            <span class="info-box-icon bg-success"><i class="fa fa-check-circle"></i></span>
            <div class="info-box-content">
                <span class="info-box-text">Đang hoạt động (hiển thị cho khách)</span>
                <span class="info-box-number font-weight-bold">@activeCount</span>
            </div>
        </div>
    </div>
    <div class="col-md-4 col-sm-12 col-12">
        <div class="info-box shadow-sm mb-2">
            <span class="info-box-icon bg-secondary"><i class="fa fa-eye-slash"></i></span>
            <div class="info-box-content">
                <span class="info-box-text">Ngừng hoạt động (đang ẩn)</span>
                <span class="info-box-number font-weight-bold">@inactiveCount</span>
            </div>
        </div>
    </div>
</div>

<!-- Main Table Card -->
<div class="card card-primary card-outline shadow-sm">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title font-weight-bold mb-0">
            <i class="fa fa-list mr-1 text-primary"></i> Danh sách danh mục
        </h3>
        <div class="card-tools ml-auto">
            <a href="@Url.Action("Create", "Categories", new { area = Convert.ToString(ViewContext.RouteData.DataTokens["area"]) })" class="btn btn-primary btn-sm">
                <i class="fa fa-plus-circle mr-1"></i> Thêm danh mục mới
            </a>
        </div>
    </div>

    <div class="card-body p-0">
        @if (Model == null || !Model.Any())
        {
            <div class="text-center py-5">
                <div class="text-muted mb-3" style="font-size: 48px;">
                    <i class="fa fa-folder-open-o"></i>
                </div>
                <h5 class="text-muted">Chưa có danh mục</h5>
                <p class="text-muted">Tạo danh mục đầu tiên để bắt đầu quản lý món ăn.</p>
                <a href="@Url.Action("Create", "Categories", new { area = Convert.ToString(ViewContext.RouteData.DataTokens["area"]) })" class="btn btn-primary">
                    <i class="fa fa-plus-circle mr-1"></i> Tạo danh mục đầu tiên
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0">
                    <thead class="thead-light">
                        <tr>
                            <th style="width: 60px;" class="text-center">#</th>
                            <th style="width: 80px;" class="text-center">Hình ảnh</th>
                            <th style="min-width: 180px;">Tên danh mục</th>
                            <th>Mô tả</th>
                            <th style="width: 130px;" class="text-center">Số món</th>
                            <th style="width: 120px;" class="text-center">Trạng thái</th>
                            <th style="width: 220px;" class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            int dishCount = item.Dishes != null ? item.Dishes.Count : 0;
                            <tr>
                                <td class="text-center align-middle font-weight-bold text-muted">
                                    @item.Id
                                </td>
                                <td class="text-center align-middle">
                                    @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                    {
                                        <img src="@Url.Content(item.ImageUrl)"
                                             alt="@item.Name"
                                             class="img-thumbnail rounded"
                                             style="width: 48px; height: 48px; object-fit: cover;"
                                             onerror="this.onerror=null; this.src='@Url.Content("~/Resources/Admin/img/default-150x150.png")';" />
                                    }
                                    else
                                    {
                                        <div class="bg-light rounded d-inline-flex align-items-center justify-content-center"
                                             style="width: 48px; height: 48px; border: 1px dashed #ccc;">
                                            <i class="fa fa-picture-o text-muted"></i>
                                        </div>
                                    }
                                </td>
                                <td class="align-middle">
                                    <strong class="text-dark font-weight-bold">@item.Name</strong>
                                    @if (dishCount > 0)
                                    {
                                        <small class="d-block text-muted">Đang chứa món ăn</small>
                                    }
                                </td>
                                <td class="align-middle text-muted">
                                    @(string.IsNullOrWhiteSpace(item.Description) ? "—" : item.Description)
                                </td>
                                <td class="text-center align-middle">
                                    <span class="badge @(dishCount > 0 ? "badge-info" : "badge-light border") px-2 py-1">
                                        <i class="fa fa-cutlery mr-1"></i> @dishCount món
                                    </span>
                                </td>
                                <td class="text-center align-middle">
                                    @if (item.IsActive)
                                    {
                                        <span class="badge badge-success px-2 py-1">
                                            <i class="fa fa-check-circle mr-1"></i> Đang hoạt động
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-secondary px-2 py-1">
                                            <i class="fa fa-eye-slash mr-1"></i> Ngừng hoạt động
                                        </span>
                                    }
                                </td>
                                <td class="text-center align-middle">
                                    <div class="d-flex justify-content-center align-items-center">
                                        <!-- Edit -->
                                        <a href="@Url.Action("Edit", "Categories", new { area = Convert.ToString(ViewContext.RouteData.DataTokens["area"]), id = item.Id })"
                                           class="btn btn-outline-primary btn-sm mr-1"
                                           title="Sửa danh mục">
                                            <i class="fa fa-pencil"></i>
                                        </a>

                                        <!-- Toggle Status -->
                                        @using (Html.BeginForm("ToggleStatus", "Categories", new { area = Convert.ToString(ViewContext.RouteData.DataTokens["area"]), id = item.Id }, FormMethod.Post, new { @class = "d-inline mr-1" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <button type="submit"
                                                    class="btn @(item.IsActive ? "btn-outline-warning" : "btn-outline-success") btn-sm"
                                                    title="@(item.IsActive ? "Deactivate (Hide from customer menu)" : "Activate (Show on customer menu)")"
                                                    onclick="return confirm('Bạn xác nhận thực hiện thao tác này?');">
                                                <i class="fa @(item.IsActive ? "fa-pause" : "fa-play")"></i>
                                            </button>
                                        }

                                        <!-- Delete -->
                                        @using (Html.BeginForm("Delete", "Categories", new { area = Convert.ToString(ViewContext.RouteData.DataTokens["area"]), id = item.Id }, FormMethod.Post, new { @class = "d-inline" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            if (dishCount > 0)
                                            {
                                                <button type="button"
                                                        class="btn btn-outline-danger btn-sm"
                                                        title="Cannot delete: Category contains @dishCount dish(es). Use Deactivate instead."
                                                        onclick="alert('Dữ liệu đang được sử dụng. Hãy ngừng hoạt động thay vì xóa.');">
                                                    <i class="fa fa-trash-o"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit"
                                                        class="btn btn-outline-danger btn-sm"
                                                        title="Xóa danh mục"
                                                        onclick="return confirm('Bạn xác nhận thực hiện thao tác này?');">
                                                    <i class="fa fa-trash-o"></i>
                                                </button>
                                            }
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="card-footer bg-light d-flex justify-content-between align-items-center">
            <span class="text-muted small">
                Đang hiển thị <strong>@totalCount</strong> danh mục (@activeCount hoạt động, @inactiveCount ngừng hoạt động)
            </span>
            <a href="@Url.Action("Create", "Categories", new { area = Convert.ToString(ViewContext.RouteData.DataTokens["area"]) })" class="btn btn-primary btn-sm">
                <i class="fa fa-plus-circle mr-1"></i> Thêm danh mục
            </a>
        </div>
    }
</div>
