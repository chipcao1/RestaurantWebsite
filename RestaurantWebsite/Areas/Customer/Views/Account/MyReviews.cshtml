@using System.Linq
@model IEnumerable<RestaurantWebsite.Models.Review>

@{
    ViewBag.Title = "Đánh giá của tôi";
    ViewBag.BodyClass = "sub_page";
}

<section class="layout_padding">
    <div class="container">
        <div class="heading_container heading_center">
            <h2>Đánh giá của tôi</h2>
        </div>




        @if (Model != null && Model.Any())
        {
            <div class="mt-4">
                @foreach (var review in Model)
                {
                    <div class="border rounded p-3 mb-3 bg-white">
                        <div class="d-flex justify-content-between">
                            <strong>@(review.Dish != null ? review.Dish.Name : "Món ăn")</strong>
                            <small class="text-muted">@review.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small>
                        </div>
                        <div class="mt-2">Rating: @review.Rating / 5</div>
                        @if (!string.IsNullOrWhiteSpace(review.Comment))
                        {
                            <p class="mb-0 mt-2">@review.Comment</p>
                        }
                    </div>
                }
            </div>
        }

        <div class="text-center mt-3">
            <a href="@Url.Action("Profile", "Account", new { area = "Customer" })" class="btn btn-outline-secondary">Về hồ sơ</a>
        </div>
    </div>
</section>
