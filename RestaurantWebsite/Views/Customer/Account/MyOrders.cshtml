@using System.Linq
@model IEnumerable<RestaurantWebsite.Models.Order>

@{
    ViewBag.Title = "My Orders";
    ViewBag.BodyClass = "sub_page";
}

<section class="layout_padding">
    <div class="container">
        <div class="heading_container heading_center">
            <h2>My Orders</h2>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
                @TempData["Success"]
                <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show mt-3" role="alert">
                @TempData["Error"]
                <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
        }

        @if (Model != null && Model.Any())
        {
            <div class="mt-4">
                @foreach (var order in Model)
                {
                    <div class="card mb-3 shadow-sm">
                        <div class="card-header bg-light d-flex justify-content-between align-items-center">
                            <div>
                                <strong>Order #@order.Id</strong>
                                <span class="badge badge-info ml-2">@order.OrderType</span>
                                <span class="badge badge-secondary ml-1">@order.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                            </div>
                            <div>
                                <span class="badge @(order.Status == "Delivered" ? "badge-success" : "badge-warning") p-2">@order.Status</span>
                                <strong class="ml-3 text-danger">@order.TotalAmount.ToString("N0") VNĐ</strong>
                            </div>
                        </div>
                        <div class="card-body p-3">
                            <h6 class="card-title text-muted mb-2">Order Items:</h6>
                            <ul class="list-group list-group-flush">
                                @foreach (var item in order.OrderItems)
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-2">
                                        <div>
                                            @if (item.Dish != null)
                                            {
                                                <span class="font-weight-bold">@item.Dish.Name</span>
                                            }
                                            else if (item.Combo != null)
                                            {
                                                <span class="font-weight-bold">@item.Combo.Name (Combo)</span>
                                            }
                                            <small class="text-muted ml-2">x @item.Quantity (@item.UnitPrice.ToString("N0") VNĐ)</small>
                                        </div>
                                        <div>
                                            @if (item.DishId.HasValue && (order.Status == "Delivered" || order.Status == "Completed" || order.Status == "Confirmed" || order.Status == "Preparing" || order.Status == "Ready" || order.Status == "Pending"))
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-warning text-dark" data-toggle="modal" data-target="#reviewModal-@order.Id-@item.DishId.Value">
                                                    <i class="fa fa-star text-warning"></i> Write Review
                                                </button>

                                                <!-- Review Modal for Dish -->
                                                <div class="modal fade" id="reviewModal-@order.Id-@item.DishId.Value" tabindex="-1" role="dialog" aria-labelledby="reviewModalLabel-@order.Id-@item.DishId.Value" aria-hidden="true">
                                                    <div class="modal-dialog" role="document">
                                                        <div class="modal-content">
                                                            @using (Html.BeginForm("CreateReview", "Account", FormMethod.Post))
                                                            {
                                                                @Html.AntiForgeryToken()
                                                                <input type="hidden" name="orderId" value="@order.Id" />
                                                                <input type="hidden" name="dishId" value="@item.DishId.Value" />
                                                                <div class="modal-header">
                                                                    <h5 class="modal-title" id="reviewModalLabel-@order.Id-@item.DishId.Value">
                                                                        Review: @(item.Dish != null ? item.Dish.Name : "Dish")
                                                                    </h5>
                                                                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                                                        <span aria-hidden="true">&times;</span>
                                                                    </button>
                                                                </div>
                                                                <div class="modal-body">
                                                                    <div class="form-group text-left">
                                                                        <label class="font-weight-bold">Rating (1 to 5 Stars):</label>
                                                                        <select name="rating" class="form-control" required>
                                                                            <option value="5" selected>5 - Excellent</option>
                                                                            <option value="4">4 - Very Good</option>
                                                                            <option value="3">3 - Good</option>
                                                                            <option value="2">2 - Fair</option>
                                                                            <option value="1">1 - Poor</option>
                                                                        </select>
                                                                    </div>
                                                                    <div class="form-group text-left">
                                                                        <label class="font-weight-bold">Your Review / Comment:</label>
                                                                        <textarea name="comment" class="form-control" rows="4" placeholder="Share details of your experience with this dish..."></textarea>
                                                                    </div>
                                                                </div>
                                                                <div class="modal-footer">
                                                                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                                                                    <button type="submit" class="btn btn-warning text-dark font-weight-bold">Submit Review</button>
                                                                </div>
                                                            }
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="alert alert-light border mt-4 text-center">
                You do not have any orders yet.
            </div>
        }

        <div class="text-center mt-3">
            <a href="@Url.Action("Profile", "Account")" class="btn btn-outline-secondary">Back to Profile</a>
        </div>
    </div>
</section>
