@{
    ViewBag.Title = "Change Password";
    ViewBag.BodyClass = "sub_page";
}

<section class="layout_padding">
    <div class="container">
        <div class="heading_container heading_center">
            <h2>Change Password</h2>
        </div>

        @if (TempData["PasswordSuccess"] != null)
        {
            <div class="alert alert-success mt-4">
                @TempData["PasswordSuccess"]
            </div>
        }

        @using (Html.BeginForm("ChangePassword", "Account", FormMethod.Post, new { @class = "col-md-6 mx-auto mt-4" }))
        {
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label>Current Password</label>
                <input type="password" name="currentPassword" class="form-control" />
                @Html.ValidationMessage("CurrentPassword", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                <label>New Password</label>
                <input type="password" name="newPassword" class="form-control" />
                @Html.ValidationMessage("NewPassword", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                <label>Confirm New Password</label>
                <input type="password" name="confirmPassword" class="form-control" />
                @Html.ValidationMessage("ConfirmPassword", new { @class = "text-danger" })
            </div>

            <button type="submit" class="btn btn-warning text-white">
                Change Password
            </button>
            <a href="@Url.Action("Profile", "Account")" class="btn btn-outline-secondary ml-2">Back to Profile</a>
        }
    </div>
</section>
