@model IEnumerable<RestaurantWebsite.Models.RestaurantTable>
@{
    Layout = "~/Views/Shared/_OperationsLayout.cshtml";
    ViewBag.Title = "Quản lý bàn nhà hàng";

    int totalCount = Model != null ? Model.Count() : 0;
    int availableCount = Model != null ? Model.Count(t => t.IsActive && t.Status == "Available") : 0;
    int occupiedCount = Model != null ? Model.Count(t => t.Status == "Occupied" || t.Status == "Reserved") : 0;
    int maintenanceCount = Model != null ? Model.Count(t => !t.IsActive || t.Status == "Maintenance") : 0;

    SelectList zones = ViewBag.Zones as SelectList;
    SelectList statuses = ViewBag.Statuses as SelectList;
    string selectedZone = ViewBag.SelectedZone as string ?? "All";
    string selectedStatus = ViewBag.SelectedStatus as string ?? "All";
    string searchTerm = ViewBag.SearchTerm as string ?? "";
}

<!-- Summary stats header -->
<div class="row mb-3">
    <div class="col-md-3 col-sm-6 col-12">
        <div class="info-box shadow-sm mb-2">
            <span class="info-box-icon bg-primary"><i class="fa fa-table"></i></span>
            <div class="info-box-content">
                <span class="info-box-text">Tổng số bàn</span>
                <span class="info-box-number font-weight-bold">@totalCount</span>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6 col-12">
        <div class="info-box shadow-sm mb-2">
            <span class="info-box-icon bg-success"><i class="fa fa-check-circle"></i></span>
            <div class="info-box-content">
                <span class="info-box-text">Sẵn sàng phục vụ</span>
                <span class="info-box-number font-weight-bold">@availableCount</span>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6 col-12">
        <div class="info-box shadow-sm mb-2">
            <span class="info-box-icon bg-warning"><i class="fa fa-user"></i></span>
            <div class="info-box-content">
                <span class="info-box-text">Đang sử dụng / đã đặt</span>
                <span class="info-box-number font-weight-bold">@occupiedCount</span>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6 col-12">
        <div class="info-box shadow-sm mb-2">
            <span class="info-box-icon bg-secondary"><i class="fa fa-wrench"></i></span>
            <div class="info-box-content">
                <span class="info-box-text">Bảo trì / đang ẩn</span>
                <span class="info-box-number font-weight-bold">@maintenanceCount</span>
            </div>
        </div>
    </div>
</div>

<!-- Filter & Search Card -->
<div class="card card-outline card-secondary mb-3 shadow-sm">
    <div class="card-body p-3">
        @using (Html.BeginForm("Index", "Tables", new { area = "Admin" }, FormMethod.Get, new { @class = "form-inline flex-wrap" }))
        {
            <div class="form-group mr-3 mb-2">
                <label for="zone" class="mr-2 font-weight-bold small"><i class="fa fa-map-marker mr-1"></i> Khu vực:</label>
                @Html.DropDownList("zone", zones, "-- All Zones --", new { @class = "form-control form-control-sm", onchange = "this.form.submit()" })
            </div>

            <div class="form-group mr-3 mb-2">
                <label for="status" class="mr-2 font-weight-bold small"><i class="fa fa-info-circle mr-1"></i> Trạng thái:</label>
                @Html.DropDownList("status", statuses, "-- Tất cả trạng thái --", new { @class = "form-control form-control-sm", onchange = "this.form.submit()" })
            </div>

            <div class="form-group mr-2 mb-2">
                <label for="search" class="sr-only">Tìm kiếm</label>
                <div class="input-group input-group-sm">
                    <input type="text" name="search" class="form-control" placeholder="Tìm theo số bàn..." value="@searchTerm" />
                    <div class="input-group-append">
                        <button type="submit" class="btn btn-secondary">
                            <i class="fa fa-search"></i> Tìm kiếm
                        </button>
                    </div>
                </div>
            </div>

            if (zones.SelectedValue != null || statuses.SelectedValue != null || !string.IsNullOrWhiteSpace(searchTerm))
            {
                <a href="@Url.Action("Index", "Tables", new { area = "Admin" })" class="btn btn-outline-dark btn-sm mb-2">
                    <i class="fa fa-undo mr-1"></i> Xóa bộ lọc
                </a>
            }
        }
    </div>
</div>

<!-- Main Tables Card -->
<div class="card card-primary card-outline shadow-sm">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title font-weight-bold mb-0">
            <i class="fa fa-table mr-1 text-primary"></i> Danh sách bàn nhà hàng
        </h3>
        <div class="card-tools ml-auto">
            <a href="@Url.Action("Create", "Tables", new { area = "Admin" })" class="btn btn-primary btn-sm">
                <i class="fa fa-plus-circle mr-1"></i> Thêm bàn mới
            </a>
        </div>
    </div>

    <div class="card-body p-0">
        @if (Model == null || !Model.Any())
        {
            <div class="text-center py-5">
                <div class="text-muted mb-3" style="font-size: 48px;">
                    <i class="fa fa-table"></i>
                </div>
                <h5 class="text-muted">Không tìm thấy bàn</h5>
                <p class="text-muted">Thử đổi bộ lọc hoặc thêm bàn mới.</p>
                <a href="@Url.Action("Create", "Tables", new { area = "Admin" })" class="btn btn-primary">
                    <i class="fa fa-plus-circle mr-1"></i> Thêm bàn đầu tiên
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0">
                    <thead class="thead-light">
                        <tr>
                            <th style="width: 60px;" class="text-center">#</th>
                            <th style="width: 140px;">Số bàn</th>
                            <th style="width: 120px;" class="text-center">Sức chứa</th>
                            <th style="width: 140px;" class="text-center">Khu vực</th>
                            <th style="width: 140px;" class="text-center">Trạng thái phục vụ</th>
                            <th style="width: 120px;" class="text-center">Tình trạng hoạt động</th>
                            <th style="width: 220px;" class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            int resCount = item.Reservations != null ? item.Reservations.Count : 0;
                            int orderCount = item.Orders != null ? item.Orders.Count : 0;
                            bool isUsed = (resCount > 0 || orderCount > 0);

                            <tr>
                                <td class="text-center align-middle font-weight-bold text-muted">
                                    @item.Id
                                </td>
                                <td class="align-middle font-weight-bold text-dark">
                                    <i class="fa fa-square-o mr-1 text-primary"></i> @item.TableNumber
                                </td>
                                <td class="text-center align-middle font-weight-bold">
                                    <span class="badge badge-light border px-2 py-1">
                                        <i class="fa fa-users mr-1 text-info"></i> @item.Capacity seats
                                    </span>
                                </td>
                                <td class="text-center align-middle">
                                    <span class="badge badge-info px-2 py-1">
                                        <i class="fa fa-map-marker mr-1"></i> @(Vietnamese.Label(item.Zone))
                                    </span>
                                </td>
                                <td class="text-center align-middle">
                                    @if (item.Status == "Available")
                                    {
                                        <span class="badge badge-success px-2 py-1">Sẵn sàng</span>
                                    }
                                    else if (item.Status == "Occupied")
                                    {
                                        <span class="badge badge-danger px-2 py-1">Đang sử dụng</span>
                                    }
                                    else if (item.Status == "Reserved")
                                    {
                                        <span class="badge badge-warning px-2 py-1">Đã đặt</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-secondary px-2 py-1">@(Vietnamese.Label(item.Status))</span>
                                    }
                                </td>
                                <td class="text-center align-middle">
                                    @if (item.IsActive)
                                    {
                                        <span class="badge badge-success px-2 py-1"><i class="fa fa-check-circle mr-1"></i> Đang hoạt động</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-secondary px-2 py-1"><i class="fa fa-eye-slash mr-1"></i> Ngừng hoạt động</span>
                                    }
                                </td>
                                <td class="text-center align-middle">
                                    <div class="d-flex justify-content-center align-items-center">
                                        <!-- Edit -->
                                        <a href="@Url.Action("Edit", "Tables", new { area = "Admin", id = item.Id })"
                                           class="btn btn-outline-primary btn-sm mr-1"
                                           title="Sửa bàn">
                                            <i class="fa fa-pencil"></i>
                                        </a>

                                        <!-- Toggle Status -->
                                        @using (Html.BeginForm("ToggleStatus", "Tables", new { area = "Admin", id = item.Id }, FormMethod.Post, new { @class = "d-inline mr-1" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <button type="submit"
                                                    class="btn @(item.IsActive ? "btn-outline-warning" : "btn-outline-success") btn-sm"
                                                    title="@(item.IsActive ? "Deactivate (Hide from booking menu)" : "Activate (Show on booking menu)")"
                                                    onclick="return confirm('Bạn xác nhận thực hiện thao tác này?');">
                                                <i class="fa @(item.IsActive ? "fa-pause" : "fa-play")"></i>
                                            </button>
                                        }

                                        <!-- Delete -->
                                        @using (Html.BeginForm("Delete", "Tables", new { area = "Admin", id = item.Id }, FormMethod.Post, new { @class = "d-inline" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            if (isUsed)
                                            {
                                                <button type="button"
                                                        class="btn btn-outline-danger btn-sm"
                                                        title="Bàn đang được tham chiếu. Hãy ngừng hoạt động thay vì xóa."
                                                        onclick="alert('Dữ liệu đang được sử dụng. Hãy ngừng hoạt động thay vì xóa.');">
                                                    <i class="fa fa-trash-o"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit"
                                                        class="btn btn-outline-danger btn-sm"
                                                        title="Xóa bàn"
                                                        onclick="return confirm('Bạn xác nhận thực hiện thao tác này?');">
                                                    <i class="fa fa-trash-o"></i>
                                                </button>
                                            }
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="card-footer bg-light d-flex justify-content-between align-items-center">
            <span class="text-muted small">
                Đang hiển thị <strong>@totalCount</strong> bàn (@availableCount sẵn sàng)
            </span>
            <a href="@Url.Action("Create", "Tables", new { area = "Admin" })" class="btn btn-primary btn-sm">
                <i class="fa fa-plus-circle mr-1"></i> Thêm bàn
            </a>
        </div>
    }
</div>
