@using RestaurantWebsite.Models
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewBag.Title = "Staff Workspace";

    string currentRole = ViewBag.CurrentRole != null ? ViewBag.CurrentRole.ToString() : "Staff";
    string userName = ViewBag.UserName != null ? ViewBag.UserName.ToString() : "Staff Member";

    int pendingOrders = ViewBag.PendingOrdersCount ?? 0;
    int processingOrders = ViewBag.ProcessingOrdersCount ?? 0;
    int todayReservationsCount = ViewBag.TodayReservationsCount ?? 0;
    int availableTables = ViewBag.AvailableTablesCount ?? 0;

    var recentOrders = ViewBag.RecentOrders as List<Order> ?? new List<Order>();
    var todayReservations = ViewBag.TodayReservations as List<Reservation> ?? new List<Reservation>();
}

<!-- Welcome Banner -->
<div class="row">
    <div class="col-12">
        <div class="callout callout-warning elevation-1 bg-white">
            <h5><i class="fa fa-desktop text-warning mr-2"></i> Staff Operational Dashboard</h5>
            <p class="mb-0 text-muted">
                Welcome, <strong>@userName</strong>! Manage dish availability, track incoming customer orders, and manage table reservations in real-time.
            </p>
        </div>
    </div>
</div>

<!-- KPI Cards -->
<div class="row">
    <div class="col-lg-3 col-6">
        <div class="small-box bg-warning">
            <div class="inner">
                <h3>@pendingOrders</h3>
                <p>Pending Orders Queue</p>
            </div>
            <div class="icon">
                <i class="fa fa-clock-o"></i>
            </div>
            <a href="@Url.Action("Orders", "Staff", new { status = "Pending" })" class="small-box-footer">
                Process Orders <i class="fa fa-arrow-circle-right"></i>
            </a>
        </div>
    </div>

    <div class="col-lg-3 col-6">
        <div class="small-box bg-info">
            <div class="inner">
                <h3>@processingOrders</h3>
                <p>In-Kitchen / Processing</p>
            </div>
            <div class="icon">
                <i class="fa fa-cog fa-spin"></i>
            </div>
            <a href="@Url.Action("Orders", "Staff", new { status = "Processing" })" class="small-box-footer">
                Kitchen Status <i class="fa fa-arrow-circle-right"></i>
            </a>
        </div>
    </div>

    <div class="col-lg-3 col-6">
        <div class="small-box bg-success">
            <div class="inner">
                <h3>@todayReservationsCount</h3>
                <p>Today's Bookings</p>
            </div>
            <div class="icon">
                <i class="fa fa-calendar"></i>
            </div>
            <a href="@Url.Action("Reservations", "Staff")" class="small-box-footer">
                View Bookings <i class="fa fa-arrow-circle-right"></i>
            </a>
        </div>
    </div>

    <div class="col-lg-3 col-6">
        <div class="small-box bg-primary">
            <div class="inner">
                <h3>@availableTables</h3>
                <p>Available Tables</p>
            </div>
            <div class="icon">
                <i class="fa fa-table"></i>
            </div>
            <a href="@Url.Action("Dishes", "Staff")" class="small-box-footer">
                Manage Menu Dishes <i class="fa fa-arrow-circle-right"></i>
            </a>
        </div>
    </div>
</div>

<!-- Main Content Row -->
<div class="row">
    <!-- Left Column: Pending & Processing Orders Queue -->
    <div class="col-lg-7">
        <div class="card card-warning card-outline">
            <div class="card-header">
                <h3 class="card-title font-weight-bold"><i class="fa fa-shopping-cart text-warning mr-2"></i>Active Orders Dispatch Queue</h3>
                <div class="card-tools">
                    <a href="@Url.Action("Orders", "Staff")" class="btn btn-warning btn-sm text-dark font-weight-bold">
                        View All Orders Queue
                    </a>
                </div>
            </div>
            <div class="card-body p-0">
                @if (!recentOrders.Any())
                {
                    <p class="text-muted p-3 mb-0 text-center">No active orders in queue right now.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-hover mb-0 align-middle">
                            <thead class="thead-light">
                                <tr>
                                    <th>#ID</th>
                                    <th>Customer</th>
                                    <th>Items</th>
                                    <th class="text-center">Status</th>
                                    <th class="text-center">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var order in recentOrders)
                                {
                                    int itemsCount = order.OrderItems?.Sum(i => i.Quantity) ?? 0;
                                    <tr>
                                        <td class="font-weight-bold">#@order.Id</td>
                                        <td>
                                            <div class="font-weight-bold">@(order.User != null ? order.User.FullName : "Guest")</div>
                                            <small class="text-muted">@order.Phone</small>
                                        </td>
                                        <td><span class="badge badge-info">@itemsCount items</span></td>
                                        <td class="text-center">
                                            @if (order.Status == "Pending")
                                            {
                                                <span class="badge badge-warning text-dark">Pending</span>
                                            }
                                            else if (order.Status == "Confirmed" || order.Status == "Preparing" || order.Status == "Ready")
                                            {
                                                <span class="badge badge-info">@order.Status</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-secondary">@order.Status</span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            @if (order.Status == "Pending")
                                            {
                                                using (Html.BeginForm("UpdateOrderStatus", "Staff", new { id = order.Id, newStatus = "Confirmed", returnAction = "Index" }, FormMethod.Post, new { style = "display:inline;" }))
                                                {
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-success btn-xs" title="Confirm Order">
                                                        <i class="fa fa-check"></i> Confirm
                                                    </button>
                                                }
                                            }
                                            else if (order.Status == "Confirmed")
                                            {
                                                using (Html.BeginForm("UpdateOrderStatus", "Staff", new { id = order.Id, newStatus = "Preparing", returnAction = "Index" }, FormMethod.Post, new { style = "display:inline;" }))
                                                {
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-primary btn-xs" title="Start Preparing">
                                                        <i class="fa fa-cog"></i> Prepare
                                                    </button>
                                                }
                                            }
                                            else if (order.Status == "Preparing")
                                            {
                                                using (Html.BeginForm("UpdateOrderStatus", "Staff", new { id = order.Id, newStatus = "Ready", returnAction = "Index" }, FormMethod.Post, new { style = "display:inline;" }))
                                                {
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-info btn-xs" title="Mark Ready">
                                                        <i class="fa fa-check-circle"></i> Ready
                                                    </button>
                                                }
                                            }
                                            else if (order.Status == "Ready")
                                            {
                                                using (Html.BeginForm("UpdateOrderStatus", "Staff", new { id = order.Id, newStatus = "Delivered", returnAction = "Index" }, FormMethod.Post, new { style = "display:inline;" }))
                                                {
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-success btn-xs" title="Mark Delivered">
                                                        <i class="fa fa-truck"></i> Deliver
                                                    </button>
                                                }
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Right Column: Today's Table Bookings -->
    <div class="col-lg-5">
        <div class="card card-success card-outline">
            <div class="card-header">
                <h3 class="card-title font-weight-bold"><i class="fa fa-calendar text-success mr-2"></i>Today's Bookings Schedule</h3>
                <div class="card-tools">
                    <a href="@Url.Action("Reservations", "Staff")" class="btn btn-success btn-sm font-weight-bold">
                        View All
                    </a>
                </div>
            </div>
            <div class="card-body p-0">
                @if (!todayReservations.Any())
                {
                    <p class="text-muted p-3 mb-0 text-center">No reservations scheduled for today.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-hover mb-0 align-middle">
                            <thead class="thead-light">
                                <tr>
                                    <th>Time & Table</th>
                                    <th>Guest</th>
                                    <th class="text-center">Status</th>
                                    <th class="text-center">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var res in todayReservations)
                                {
                                    <tr>
                                        <td>
                                            <div class="font-weight-bold text-success"><i class="fa fa-clock-o mr-1"></i>@res.ReservationDate.ToString("HH:mm")</div>
                                            <small class="text-muted">Table @(res.Table != null ? res.Table.TableNumber : res.TableId.ToString())</small>
                                        </td>
                                        <td>
                                            <div class="font-weight-bold">@(res.User != null ? res.User.FullName : "Guest")</div>
                                            <small class="text-muted">@res.PartySize seats</small>
                                        </td>
                                        <td class="text-center">
                                            @if (res.Status == "Pending")
                                            {
                                                <span class="badge badge-warning text-dark">Pending</span>
                                            }
                                            else if (res.Status == "Confirmed")
                                            {
                                                <span class="badge badge-info">Confirmed</span>
                                            }
                                            else if (res.Status == "Completed")
                                            {
                                                <span class="badge badge-success">Completed</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-secondary">@res.Status</span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            @if (res.Status == "Pending")
                                            {
                                                using (Html.BeginForm("UpdateReservationStatus", "Staff", new { id = res.Id, newStatus = "Confirmed", returnAction = "Index" }, FormMethod.Post, new { style = "display:inline;" }))
                                                {
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-success btn-xs" title="Confirm Booking">
                                                        <i class="fa fa-check"></i>
                                                    </button>
                                                }
                                            }
                                            else if (res.Status == "Confirmed")
                                            {
                                                using (Html.BeginForm("UpdateReservationStatus", "Staff", new { id = res.Id, newStatus = "Completed", returnAction = "Index" }, FormMethod.Post, new { style = "display:inline;" }))
                                                {
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-primary btn-xs" title="Mark Completed">
                                                        <i class="fa fa-flag-checkered"></i>
                                                    </button>
                                                }
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
