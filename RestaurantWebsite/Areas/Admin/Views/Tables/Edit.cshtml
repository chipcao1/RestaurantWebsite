@model RestaurantWebsite.Models.RestaurantTable
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewBag.Title = "Edit Table - " + Model.TableNumber;

    SelectList zones = ViewBag.Zones as SelectList;
    SelectList statuses = ViewBag.Statuses as SelectList;

    int resCount = Model.Reservations != null ? Model.Reservations.Count : 0;
    int orderCount = Model.Orders != null ? Model.Orders.Count : 0;
}

<div class="row justify-content-center">
    <div class="col-lg-8 col-md-10 col-12">
        <div class="card card-info card-outline shadow-sm">
            <div class="card-header">
                <h3 class="card-title font-weight-bold">
                    <i class="fa fa-pencil text-info mr-1"></i> Edit Table: <strong>@Model.TableNumber</strong>
                </h3>
                <div class="card-tools">
                    <a href="@Url.Action("Index", "Tables", new { area = "Admin" })" class="btn btn-outline-secondary btn-sm">
                        <i class="fa fa-arrow-left mr-1"></i> Back to Tables List
                    </a>
                </div>
            </div>

            @using (Html.BeginForm("Edit", "Tables", new { area = "Admin" }, FormMethod.Post, new { @class = "form-horizontal" }))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.Id)

                <div class="card-body">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <h5><i class="fa fa-exclamation-triangle mr-2"></i> Please correct the following errors:</h5>
                            @Html.ValidationSummary(false, "", new { @class = "mb-0 pl-3 text-white" })
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">&times;</span>
                            </button>
                        </div>
                    }

                    @if (resCount > 0 || orderCount > 0)
                    {
                        <div class="callout callout-info py-2 mb-3 bg-light">
                            <i class="fa fa-info-circle text-info mr-1"></i>
                            This table is referenced by <strong>@resCount</strong> reservation(s) and <strong>@orderCount</strong> order(s).
                            To temporarily disable bookings on this table, change Active Status to <em>Inactive</em> or set Status to <em>Maintenance</em>.
                        </div>
                    }

                    <!-- Table ID (Display only) -->
                    <div class="form-group row">
                        <label class="col-sm-3 col-form-label text-muted">
                            Table ID
                        </label>
                        <div class="col-sm-9 d-flex align-items-center">
                            <span class="badge badge-light border px-3 py-2 font-weight-bold">#@Model.Id</span>
                        </div>
                    </div>

                    <!-- Table Number -->
                    <div class="form-group row">
                        <label for="TableNumber" class="col-sm-3 col-form-label font-weight-bold">
                            Table Number <span class="text-danger">*</span>
                        </label>
                        <div class="col-sm-9">
                            @Html.TextBoxFor(m => m.TableNumber, new {
                                @class = "form-control",
                                placeholder = "e.g. T01, T02...",
                                maxlength = "20",
                                required = "required"
                            })
                            @Html.ValidationMessageFor(m => m.TableNumber, "", new { @class = "text-danger small" })
                        </div>
                    </div>

                    <!-- Capacity -->
                    <div class="form-group row">
                        <label for="Capacity" class="col-sm-3 col-form-label font-weight-bold">
                            Capacity (Seats) <span class="text-danger">*</span>
                        </label>
                        <div class="col-sm-9">
                            <div class="input-group">
                                @Html.TextBoxFor(m => m.Capacity, new {
                                    @class = "form-control",
                                    type = "number",
                                    min = "1",
                                    max = "50",
                                    required = "required"
                                })
                                <div class="input-group-append">
                                    <span class="input-group-text"><i class="fa fa-users"></i> seats</span>
                                </div>
                            </div>
                            @Html.ValidationMessageFor(m => m.Capacity, "", new { @class = "text-danger small" })
                        </div>
                    </div>

                    <!-- Zone -->
                    <div class="form-group row">
                        <label for="Zone" class="col-sm-3 col-form-label font-weight-bold">
                            Zone / Area <span class="text-danger">*</span>
                        </label>
                        <div class="col-sm-9">
                            @Html.DropDownListFor(m => m.Zone, zones, "-- Select Zone --", new {
                                @class = "form-control",
                                required = "required"
                            })
                            @Html.ValidationMessageFor(m => m.Zone, "", new { @class = "text-danger small" })
                        </div>
                    </div>

                    <!-- Operational Status -->
                    <div class="form-group row">
                        <label for="Status" class="col-sm-3 col-form-label font-weight-bold">
                            Operational Status
                        </label>
                        <div class="col-sm-9">
                            @Html.DropDownListFor(m => m.Status, statuses, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.Status, "", new { @class = "text-danger small" })
                        </div>
                    </div>

                    <!-- IsActive -->
                    <div class="form-group row align-items-center">
                        <label class="col-sm-3 col-form-label font-weight-bold">
                            Active Status
                        </label>
                        <div class="col-sm-9">
                            <div class="custom-control custom-checkbox">
                                @Html.CheckBoxFor(m => m.IsActive, new { @class = "custom-control-input", id = "isActiveCheck" })
                                <label class="custom-control-label font-weight-normal" for="isActiveCheck">
                                    <strong>Active</strong> (Table is available for booking)
                                </label>
                            </div>
                        </div>
                    </div>

                </div>

                <div class="card-footer bg-light d-flex justify-content-between">
                    <a href="@Url.Action("Index", "Tables", new { area = "Admin" })" class="btn btn-default">
                        <i class="fa fa-times mr-1"></i> Cancel
                    </a>
                    <button type="submit" class="btn btn-primary font-weight-bold px-4">
                        <i class="fa fa-check mr-1"></i> Update Table
                    </button>
                </div>
            }
        </div>
    </div>
</div>
