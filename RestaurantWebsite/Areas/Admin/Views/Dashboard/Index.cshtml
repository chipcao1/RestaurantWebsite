@using RestaurantWebsite.Infrastructure
@using RestaurantWebsite.Areas.Admin.Controllers
@{ViewBag.Title="Tổng quan nhà hàng";var top=ViewBag.TopDishes as IEnumerable<TopDishItem>??new List<TopDishItem>();var daily=ViewBag.DailyRevenues as List<decimal>??new List<decimal>();var labels=ViewBag.DailyLabels as List<string>??new List<string>();decimal peak=daily.Count>0?daily.Max():0m;}
<div class="page-heading">
<div>
<p class="eyebrow">NHÀ HÀNG FEANE · HÔM NAY</p>
<h1>Chào ngày mới, @Session["UserName"]</h1>
<p>Nắm tình hình phục vụ và kết quả kinh doanh tại một nơi.</p>
</div>
<a class="btn btn-warning" href="@Url.Action("Index", "Reports",new{area="Admin"})">Xem báo cáo doanh thu</a>
</div>
<div class="metric-grid">
<div class="metric">
<span>Thu ròng hôm nay</span>
<strong>@Vietnamese.Money((decimal)ViewBag.TodayRevenue)</strong>
</div>
<div class="metric">
<span>Thu ròng tháng này</span>
<strong>@Vietnamese.Money((decimal)ViewBag.MonthRevenue)</strong>
</div>
<div class="metric">
<span>Đơn đang chờ xác nhận</span>
<strong>@ViewBag.PendingOrdersCount</strong>
<a href="@Url.Action("Index", "Orders",new{area="Admin",status="Pending"})">Đến hàng đợi →</a>
</div>
</div>
<div class="row mt-4">
<div class="col-lg-8">
<section class="surface">
<div class="page-heading">
<div>
<h2>Dòng tiền trong tháng</h2>
<p>Số tiền đã thu trừ khoản đã hoàn theo ngày giao dịch.</p>
</div>
</div>
<div class="revenue-bars" role="img" aria-label="Doanh thu ròng từng ngày trong tháng">
@for(int i=0;i<daily.Count;i++){<div class="revenue-bar">
<span>@labels[i]</span>
<div style="width:@(peak>0?Math.Max(0,daily[i])/peak*100:0)%">
</div>
<strong>@Vietnamese.Money(daily[i])</strong>
</div>}
</div>
</section>
</div>
<div class="col-lg-4">
<section class="surface">
<p class="eyebrow">CẦN THEO DÕI</p>
<h2>Vận hành hôm nay</h2>
<p>
<strong>@ViewBag.TodayOrderCount</strong> đơn đã đặt</p>
<p>
<strong>@ViewBag.TodayReservationsCount</strong> lượt đặt bàn</p>
<p>
<strong>@ViewBag.TotalCustomersCount</strong> khách hàng</p>
<p>
<strong>@ViewBag.ActivePromotionsCount</strong> khuyến mãi đang áp dụng</p>
<a href="@Url.Action("Index", "Reservations",new{area="Admin"})">Xem lịch đặt bàn →</a>
</section>
<section class="surface">
<h2>Món được yêu thích</h2>
<p class="text-muted">Từ các đơn đã thanh toán.</p>@foreach(var dish in top){<div class="d-flex justify-content-between border-top py-3">
<span>@dish.DishName</span>
<strong>@dish.TotalQuantity phần</strong>
</div>}@if(!top.Any()){<p>Chưa có dữ liệu món đã bán.</p>}</section>
</div>
</div>
