@using System.Linq
@model RestaurantWebsite.Models.Order

@{
    ViewBag.Title = "Đặt món thành công";
    ViewBag.BodyClass = "sub_page";

    var payment = Model.Payments != null
        ? Model.Payments.OrderByDescending(p => p.PaymentDate).FirstOrDefault()
        : null;
}

<section class="food_section layout_padding">

    <div class="container">

        <div class="heading_container heading_center mb-4">
            <h2>Đặt món thành công</h2>
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-8">

                <div class="bg-white p-4 rounded shadow-sm">

                    <div class="text-center mb-4">
                        <i class="fa fa-check-circle"
                           aria-hidden="true"
                           style="font-size:60px;color:#ffbe33;"></i>

                        <h3 class="mt-3">Cảm ơn bạn đã đặt món!</h3>
                        <p class="text-muted mb-0">
                            Đơn @(Vietnamese.Label(Model.OrderType)) của bạn đang ở trạng thái <strong>Chờ xác nhận</strong>.
                        </p>
                    </div>

                    <div class="border rounded p-3 mb-3">
                        <div class="d-flex justify-content-between mb-2">
                            <span>Mã đơn</span>
                            <strong>#@Model.Id</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Hình thức phục vụ</span>
                            <strong>@(Vietnamese.Label(Model.OrderType))</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Thanh toán</span>
                            <strong>@(payment != null ? Vietnamese.Label(payment.PaymentMethod) : "Chưa có")</strong>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span>Trạng thái</span>
                            <strong class="text-warning">@(Vietnamese.Label(Model.Status))</strong>
                        </div>
                    </div>

                    @if (Model.OrderType == "Delivery" && !string.IsNullOrEmpty(Model.DeliveryAddress))
                    {
                        <div class="mb-3">
                            <strong>Địa chỉ nhận hàng</strong>
                            <div class="text-muted mt-1">
                                @Model.DeliveryAddress
                            </div>
                        </div>
                    }

                    <div class="d-flex justify-content-between border-top pt-3">
                        <span>Tạm tính</span>
                        <strong>@Model.SubTotal.ToString("N0") VNĐ</strong>
                    </div>

                    <div class="d-flex justify-content-between mt-2">
                        <span>Giảm giá</span>
                        <strong>-@Model.DiscountAmount.ToString("N0") VNĐ</strong>
                    </div>

                    <div class="d-flex justify-content-between mt-2">
                        <span>Phí giao hàng</span>
                        <strong>@Model.DeliveryFee.ToString("N0") VNĐ</strong>
                    </div>

                    <div class="d-flex justify-content-between mt-3 pt-3 border-top">
                        <strong>Tổng cộng</strong>
                        <strong class="text-danger">
                            @Model.TotalAmount.ToString("N0") VNĐ
                        </strong>
                    </div>

                    <div class="text-center mt-4">
                        <a href="@Url.Action("Receipt", "Order", new { area = "Customer",  id = Model.Id })"
                           target="_blank"
                           class="btn btn-warning text-dark font-weight-bold mr-2">
                            <i class="fa fa-print mr-1"></i> Xem hóa đơn
                        </a>

                        <a href="@Url.Action("Index", "Menu", new { area = "Customer" })"
                           class="btn btn-outline-warning text-dark mr-2">
                            Tiếp tục chọn món
                        </a>

                        <a href="@Url.RouteUrl("CustomerHome")"
                           class="btn btn-outline-secondary">
                            Về trang chủ
                        </a>
                    </div>

                </div>

            </div>
        </div>

    </div>

</section>
