@model RestaurantWebsite.Models.Promotion

@{
    ViewBag.Title = "Edit Promotion";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    int linkedOrdersCount = Model.OrderPromotions?.Count ?? 0;
}

<div class="row">
    <div class="col-md-9 col-lg-8 mx-auto">

        @if (linkedOrdersCount > 0 || Model.UsedCount > 0)
        {
            <div class="alert alert-warning">
                <i class="fa fa-exclamation-triangle mr-2"></i>
                <strong>Notice:</strong> This promotion has already been redeemed <strong>@Model.UsedCount time(s)</strong> and is linked to <strong>@linkedOrdersCount order(s)</strong>. Safe Delete is disabled for this record.
            </div>
        }

        <div class="card card-warning">
            <div class="card-header">
                <h3 class="card-title text-white"><i class="fa fa-edit mr-2"></i>Edit Promotion: @Model.Code</h3>
            </div>

            @using (Html.BeginForm("Edit", "Promotion", FormMethod.Post, new { @class = "form-horizontal" }))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.Id)
                @Html.HiddenFor(m => m.UsedCount)

                <div class="card-body">
                    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                    <div class="form-group row">
                        <label for="Code" class="col-sm-3 col-form-label font-weight-bold">Code <span class="text-danger">*</span></label>
                        <div class="col-sm-9">
                            @Html.TextBoxFor(m => m.Code, new { @class = "form-control text-uppercase", required = "required" })
                            @Html.ValidationMessageFor(m => m.Code, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group row">
                        <label for="Name" class="col-sm-3 col-form-label font-weight-bold">Name <span class="text-danger">*</span></label>
                        <div class="col-sm-9">
                            @Html.TextBoxFor(m => m.Name, new { @class = "form-control", required = "required" })
                            @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group row">
                        <label for="Description" class="col-sm-3 col-form-label font-weight-bold">Description</label>
                        <div class="col-sm-9">
                            @Html.TextAreaFor(m => m.Description, new { @class = "form-control", rows = 3 })
                            @Html.ValidationMessageFor(m => m.Description, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <hr />

                    <div class="form-group row">
                        <label for="DiscountType" class="col-sm-3 col-form-label font-weight-bold">Discount Type <span class="text-danger">*</span></label>
                        <div class="col-sm-9">
                            @Html.DropDownListFor(m => m.DiscountType, (SelectList)ViewBag.DiscountTypes, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.DiscountType, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group row">
                        <label for="DiscountValue" class="col-sm-3 col-form-label font-weight-bold">Discount Value <span class="text-danger">*</span></label>
                        <div class="col-sm-9">
                            @Html.TextBoxFor(m => m.DiscountValue, new { @class = "form-control", type = "number", step = "0.01", min = "0.01", required = "required" })
                            @Html.ValidationMessageFor(m => m.DiscountValue, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group row">
                        <label for="MinimumOrderAmount" class="col-sm-3 col-form-label font-weight-bold">Min Order ($)</label>
                        <div class="col-sm-9">
                            @Html.TextBoxFor(m => m.MinimumOrderAmount, new { @class = "form-control", type = "number", step = "0.01", min = "0" })
                            @Html.ValidationMessageFor(m => m.MinimumOrderAmount, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group row">
                        <label for="MaximumDiscount" class="col-sm-3 col-form-label font-weight-bold">Max Discount ($)</label>
                        <div class="col-sm-9">
                            @Html.TextBoxFor(m => m.MaximumDiscount, new { @class = "form-control", type = "number", step = "0.01", min = "0" })
                            @Html.ValidationMessageFor(m => m.MaximumDiscount, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <hr />

                    <div class="form-group row">
                        <label for="StartDate" class="col-sm-3 col-form-label font-weight-bold">Start Date <span class="text-danger">*</span></label>
                        <div class="col-sm-9">
                            <input type="datetime-local" id="StartDate" name="StartDate" class="form-control" value="@Model.StartDate.ToString("yyyy-MM-ddTHH:mm")" required />
                            @Html.ValidationMessageFor(m => m.StartDate, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group row">
                        <label for="EndDate" class="col-sm-3 col-form-label font-weight-bold">End Date <span class="text-danger">*</span></label>
                        <div class="col-sm-9">
                            <input type="datetime-local" id="EndDate" name="EndDate" class="form-control" value="@Model.EndDate.ToString("yyyy-MM-ddTHH:mm")" required />
                            @Html.ValidationMessageFor(m => m.EndDate, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group row">
                        <label for="UsageLimit" class="col-sm-3 col-form-label font-weight-bold">Usage Limit</label>
                        <div class="col-sm-9">
                            @Html.TextBoxFor(m => m.UsageLimit, new { @class = "form-control", type = "number", min = "1" })
                            @Html.ValidationMessageFor(m => m.UsageLimit, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group row">
                        <label class="col-sm-3 col-form-label font-weight-bold">Used Count</label>
                        <div class="col-sm-9">
                            <input type="text" class="form-control-plaintext font-weight-bold text-info" value="@Model.UsedCount" readonly />
                        </div>
                    </div>

                    <div class="form-group row">
                        <div class="col-sm-9 offset-sm-3">
                            <div class="custom-control custom-checkbox">
                                @Html.CheckBoxFor(m => m.IsActive, new { @class = "custom-control-input", id = "IsActive" })
                                <label class="custom-control-label font-weight-bold" for="IsActive">Is Active</label>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card-footer text-right">
                    <a href="@Url.Action("Index", "Promotion")" class="btn btn-default mr-2">
                        <i class="fa fa-arrow-left mr-1"></i> Cancel
                    </a>
                    <button type="submit" class="btn btn-warning text-white">
                        <i class="fa fa-save mr-1"></i> Save Changes
                    </button>
                </div>
            }
        </div>
    </div>
</div>
