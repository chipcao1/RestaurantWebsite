@model RestaurantWebsite.Models.User

@{
    ViewBag.Title = "Hồ sơ cá nhân";
    ViewBag.BodyClass = "sub_page";
}

<section class="layout_padding">
    <div class="container">
        <div class="heading_container heading_center">
            <h2>Hồ sơ cá nhân</h2>
        </div>



        <div class="row mt-4">
            <div class="col-md-8 mx-auto">
                @using (Html.BeginForm("Profile", "Account", new { area = "Customer" }, FormMethod.Post))
                {
                    @Html.AntiForgeryToken()

                    <div class="form-group">
                        <label>Họ và tên</label>
                        @Html.TextBoxFor(m => m.FullName, new { @class = "form-control", maxlength = "100" })
                        @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger" })
                    </div>

                    <div class="form-group">
                        <label>Email</label>
                        @Html.TextBoxFor(m => m.Email, new { @class = "form-control", @readonly = "readonly" })
                    </div>

                    <div class="form-group">
                        <label>Điện thoại</label>
                        @Html.TextBoxFor(m => m.Phone, new { @class = "form-control", maxlength = "20" })
                    </div>

                    <div class="form-group">
                        <label>Địa chỉ</label>
                        @Html.TextAreaFor(m => m.Address, new { @class = "form-control", rows = "3", maxlength = "250" })
                    </div>

                    <button type="submit" class="btn btn-warning text-white">
                        <i class="fa fa-save mr-1"></i> Lưu thay đổi
                    </button>

                    <a href="@Url.Action("ChangePassword", "Account", new { area = "Customer" })" class="btn btn-outline-secondary ml-2">
                        Đổi mật khẩu
                    </a>
                }
            </div>
        </div>

        <div class="row mt-4 justify-content-center">
            <div class="col-md-3 mb-2">
                <a href="@Url.Action("MyOrders", "Account", new { area = "Customer" })" class="btn btn-outline-warning btn-block">Đơn hàng của tôi</a>
            </div>
            <div class="col-md-3 mb-2">
                <a href="@Url.Action("MyReservations", "Account", new { area = "Customer" })" class="btn btn-outline-warning btn-block">Lịch đặt bàn của tôi</a>
            </div>
            <div class="col-md-3 mb-2">
                <a href="@Url.Action("MyReviews", "Account", new { area = "Customer" })" class="btn btn-outline-warning btn-block">Đánh giá của tôi</a>
            </div>
        </div>
    </div>
</section>
