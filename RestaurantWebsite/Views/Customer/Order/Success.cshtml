@using System.Linq
@model RestaurantWebsite.Models.Order

@{
    ViewBag.Title = "Order Success";
    ViewBag.BodyClass = "sub_page";

    var payment = Model.Payments != null
        ? Model.Payments.OrderByDescending(p => p.PaymentDate).FirstOrDefault()
        : null;
}

<section class="food_section layout_padding">

    <div class="container">

        <div class="heading_container heading_center mb-4">
            <h2>Order Placed Successfully</h2>
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-8">

                <div class="bg-white p-4 rounded shadow-sm">

                    <div class="text-center mb-4">
                        <i class="fa fa-check-circle"
                           aria-hidden="true"
                           style="font-size:60px;color:#ffbe33;"></i>

                        <h3 class="mt-3">Thank you for your order!</h3>
                        <p class="text-muted mb-0">
                            Your online delivery order is now <strong>Pending</strong>.
                        </p>
                    </div>

                    <div class="border rounded p-3 mb-3">
                        <div class="d-flex justify-content-between mb-2">
                            <span>Order ID</span>
                            <strong>#@Model.Id</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Order Type</span>
                            <strong>Delivery</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Payment</span>
                            <strong>@(payment != null ? payment.PaymentMethod : "N/A")</strong>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span>Status</span>
                            <strong class="text-warning">@Model.Status</strong>
                        </div>
                    </div>

                    <div class="mb-3">
                        <strong>Delivery Address</strong>
                        <div class="text-muted mt-1">
                            @Model.DeliveryAddress
                        </div>
                    </div>

                    <div class="d-flex justify-content-between border-top pt-3">
                        <span>Subtotal</span>
                        <strong>@Model.SubTotal.ToString("N0") VNĐ</strong>
                    </div>

                    <div class="d-flex justify-content-between mt-2">
                        <span>Discount</span>
                        <strong>-@Model.DiscountAmount.ToString("N0") VNĐ</strong>
                    </div>

                    <div class="d-flex justify-content-between mt-2">
                        <span>Delivery Fee</span>
                        <strong>@Model.DeliveryFee.ToString("N0") VNĐ</strong>
                    </div>

                    <div class="d-flex justify-content-between mt-3 pt-3 border-top">
                        <strong>Total</strong>
                        <strong class="text-danger">
                            @Model.TotalAmount.ToString("N0") VNĐ
                        </strong>
                    </div>

                    <div class="text-center mt-4">
                        <a href="@Url.Action("Receipt", "Order", new { id = Model.Id })"
                           target="_blank"
                           class="btn btn-warning text-dark font-weight-bold mr-2">
                            <i class="fa fa-print mr-1"></i> View Receipt
                        </a>

                        <a href="@Url.Action("Index", "Menu")"
                           class="btn btn-outline-warning text-dark mr-2">
                            Continue Shopping
                        </a>

                        <a href="@Url.RouteUrl("CustomerHome")"
                           class="btn btn-outline-secondary">
                            Back to Home
                        </a>
                    </div>

                </div>

            </div>
        </div>

    </div>

</section>
