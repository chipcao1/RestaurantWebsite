@model IEnumerable<RestaurantWebsite.Models.Reservation>

@{
    ViewBag.Title = "Staff - Table Reservations";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="card card-success card-outline">
    <div class="card-header">
        <h3 class="card-title font-weight-bold"><i class="fa fa-calendar text-success mr-2"></i>Table Bookings Schedule</h3>
        <div class="card-tools">
            <span class="badge badge-success">Staff Area</span>
        </div>
    </div>

    <div class="card-body">
        <!-- Search & Filter Form -->
        @using (Html.BeginForm("Reservations", "Staff", FormMethod.Get, new { @class = "form-inline mb-4" }))
        {
            <div class="form-group mr-2 mb-2">
                <label class="mr-2 font-weight-bold">Status:</label>
                @Html.DropDownList("status", (SelectList)ViewBag.StatusList, "All Statuses", new { @class = "form-control form-control-sm", onchange = "this.form.submit()" })
            </div>

            <div class="form-group mr-2 mb-2">
                <label class="mr-2 font-weight-bold">Date:</label>
                <input type="date" name="date" class="form-control form-control-sm" value="@ViewBag.SelectedDate" onchange="this.form.submit()" />
            </div>

            <div class="form-group mr-2 mb-2">
                <div class="input-group input-group-sm">
                    <input type="text" name="search" class="form-control" placeholder="Customer, phone, table..." value="@ViewBag.SearchTerm" />
                    <div class="input-group-append">
                        <button type="submit" class="btn btn-default">
                            <i class="fa fa-search"></i>
                        </button>
                    </div>
                </div>
            </div>

            if (!string.IsNullOrEmpty(ViewBag.SearchTerm) || ViewBag.SelectedStatus != "All" || !string.IsNullOrEmpty(ViewBag.SelectedDate))
            {
                <a href="@Url.Action("Reservations", "Staff")" class="btn btn-outline-secondary btn-sm mb-2 ml-1">
                    <i class="fa fa-times"></i> Reset Filters
                </a>
            }
        }

        <!-- Table -->
        @if (!Model.Any())
        {
            <div class="alert alert-info text-center my-4">
                <i class="fa fa-info-circle fa-2x d-block mb-2"></i>
                <h5>No table reservations found.</h5>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-bordered table-hover table-striped align-middle">
                    <thead class="thead-dark">
                        <tr>
                            <th style="width: 50px;" class="text-center">#ID</th>
                            <th>Customer Info</th>
                            <th>Assigned Table</th>
                            <th class="text-center">Seats</th>
                            <th>Date & Time Window</th>
                            <th class="text-center">Status</th>
                            <th style="width: 220px;" class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-center font-weight-bold">#@item.Id</td>
                                <td>
                                    <div class="font-weight-bold">@(item.User != null ? item.User.FullName : "Guest Customer")</div>
                                    <small class="text-muted d-block"><i class="fa fa-phone mr-1"></i>@(item.User != null && !string.IsNullOrEmpty(item.User.Phone) ? item.User.Phone : "N/A")</small>
                                </td>
                                <td>
                                    <span class="badge badge-primary px-2 py-1 font-weight-bold">
                                        <i class="fa fa-table mr-1"></i>Table @(item.Table != null ? item.Table.TableNumber : item.TableId.ToString())
                                    </span>
                                    @if (item.Table != null)
                                    {
                                        <small class="d-block text-muted">Zone: @item.Table.Zone</small>
                                    }
                                </td>
                                <td class="text-center font-weight-bold">@item.PartySize</td>
                                <td>
                                    <div class="font-weight-bold"><i class="fa fa-calendar text-primary mr-1"></i>@item.ReservationDate.ToString("yyyy-MM-dd")</div>
                                    <div class="text-success"><i class="fa fa-clock-o mr-1"></i>@item.ReservationDate.ToString("HH:mm") <small class="text-muted">(2h window)</small></div>
                                </td>
                                <td class="text-center">
                                    @if (item.Status == "Pending")
                                    {
                                        <span class="badge badge-warning text-dark px-2 py-1">Pending</span>
                                    }
                                    else if (item.Status == "Confirmed")
                                    {
                                        <span class="badge badge-info px-2 py-1">Confirmed</span>
                                    }
                                    else if (item.Status == "Completed")
                                    {
                                        <span class="badge badge-success px-2 py-1">Completed</span>
                                    }
                                    else if (item.Status == "Cancelled")
                                    {
                                        <span class="badge badge-secondary px-2 py-1">Cancelled</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-dark">@item.Status</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (item.Status == "Pending")
                                    {
                                        using (Html.BeginForm("UpdateReservationStatus", "Staff", new { id = item.Id, newStatus = "Confirmed" }, FormMethod.Post, new { style = "display:inline;" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-success btn-sm"><i class="fa fa-check mr-1"></i> Confirm</button>
                                        }
                                    }
                                    else if (item.Status == "Confirmed")
                                    {
                                        using (Html.BeginForm("UpdateReservationStatus", "Staff", new { id = item.Id, newStatus = "Completed" }, FormMethod.Post, new { style = "display:inline;" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-primary btn-sm"><i class="fa fa-flag-checkered mr-1"></i> Complete</button>
                                        }
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
