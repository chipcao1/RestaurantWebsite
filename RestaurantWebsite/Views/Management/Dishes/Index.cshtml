@{ Layout = "~/Views/Shared/_OperationsLayout.cshtml"; }
@model IEnumerable<RestaurantWebsite.Models.Dish>
@{
    Layout = "~/Views/Shared/_OperationsLayout.cshtml";
    ViewBag.Title = "Món ăn và thực đơn";

    int availableCount = Model != null ? Model.Count(d => d.Status == "Available") : 0;
    int unavailableCount = Model != null ? Model.Count(d => d.Status != "Available") : 0;
    int totalCount = Model != null ? Model.Count() : 0;

    SelectList categories = ViewBag.Categories as SelectList;
    string selectedStatus = ViewBag.SelectedStatus as string ?? "All";
    string searchTerm = ViewBag.SearchTerm as string ?? "";
}

<!-- Summary stats header -->
<div class="row mb-3">
    <div class="col-md-4 col-sm-6 col-12">
        <div class="info-box shadow-sm mb-2">
            <span class="info-box-icon bg-success"><i class="fa fa-cutlery"></i></span>
            <div class="info-box-content">
                <span class="info-box-text">Tổng số món</span>
                <span class="info-box-number font-weight-bold">@totalCount</span>
            </div>
        </div>
    </div>
    <div class="col-md-4 col-sm-6 col-12">
        <div class="info-box shadow-sm mb-2">
            <span class="info-box-icon bg-info"><i class="fa fa-check-circle"></i></span>
            <div class="info-box-content">
                <span class="info-box-text">Đang phục vụ (trên thực đơn)</span>
                <span class="info-box-number font-weight-bold">@availableCount</span>
            </div>
        </div>
    </div>
    <div class="col-md-4 col-sm-12 col-12">
        <div class="info-box shadow-sm mb-2">
            <span class="info-box-icon bg-secondary"><i class="fa fa-pause-circle"></i></span>
            <div class="info-box-content">
                <span class="info-box-text">Ngừng phục vụ (đang ẩn)</span>
                <span class="info-box-number font-weight-bold">@unavailableCount</span>
            </div>
        </div>
    </div>
</div>

<!-- Filter & Search Card -->
<div class="card card-outline card-secondary mb-3 shadow-sm">
    <div class="card-body p-3">
        @using (Html.BeginForm("Index", "Dishes", new { area = Convert.ToString(ViewContext.RouteData.DataTokens["area"]) }, FormMethod.Get, new { @class = "form-inline flex-wrap" }))
        {
            <div class="form-group mr-3 mb-2">
                <label for="categoryId" class="mr-2 font-weight-bold small"><i class="fa fa-filter mr-1"></i> Danh mục:</label>
                @Html.DropDownList("categoryId", categories, "Tất cả danh mục", new { @class = "form-control form-control-sm", onchange = "this.form.submit()" })
            </div>

            <div class="form-group mr-3 mb-2">
                <label for="status" class="mr-2 font-weight-bold small">Trạng thái:</label>
                <select name="status" class="form-control form-control-sm" onchange="this.form.submit()">
                    <option value="All" @(selectedStatus == "All" ? "selected" : "")>-- Tất cả trạng thái --</option>
                    <option value="Available" @(selectedStatus == "Available" ? "selected" : "")>Sẵn sàng</option>
                    <option value="Temporarily Unavailable" @(selectedStatus == "Temporarily Unavailable" ? "selected" : "")>Tạm ngừng phục vụ</option>
                    <option value="Discontinued" @(selectedStatus == "Discontinued" ? "selected" : "")>Ngừng kinh doanh</option>
                </select>
            </div>

            <div class="form-group mr-2 mb-2">
                <label for="search" class="sr-only">Tìm kiếm</label>
                <div class="input-group input-group-sm">
                    <input type="text" name="search" class="form-control" placeholder="Tìm theo tên món..." value="@searchTerm" />
                    <div class="input-group-append">
                        <button type="submit" class="btn btn-secondary">
                            <i class="fa fa-search"></i> Tìm kiếm
                        </button>
                    </div>
                </div>
            </div>

            if (categories.SelectedValue != null || selectedStatus != "All" || !string.IsNullOrWhiteSpace(searchTerm))
            {
                <a href="@Url.Action("Index", "Dishes", new { area = Convert.ToString(ViewContext.RouteData.DataTokens["area"]) })" class="btn btn-outline-dark btn-sm mb-2">
                    <i class="fa fa-undo mr-1"></i> Xóa bộ lọc
                </a>
            }
        }
    </div>
</div>

<!-- Main Dishes Table Card -->
<div class="card card-success card-outline shadow-sm">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title font-weight-bold mb-0">
            <i class="fa fa-cutlery mr-1 text-success"></i> Danh sách món ăn
        </h3>
        <div class="card-tools ml-auto">
            <a href="@Url.Action("Create", "Dishes", new { area = Convert.ToString(ViewContext.RouteData.DataTokens["area"]) })" class="btn btn-success btn-sm">
                <i class="fa fa-plus-circle mr-1"></i> Thêm món mới
            </a>
        </div>
    </div>

    <div class="card-body p-0">
        @if (Model == null || !Model.Any())
        {
            <div class="text-center py-5">
                <div class="text-muted mb-3" style="font-size: 48px;">
                    <i class="fa fa-cutlery"></i>
                </div>
                <h5 class="text-muted">Không tìm thấy món</h5>
                <p class="text-muted">Thử đổi bộ lọc hoặc thêm món mới.</p>
                <a href="@Url.Action("Create", "Dishes", new { area = Convert.ToString(ViewContext.RouteData.DataTokens["area"]) })" class="btn btn-success">
                    <i class="fa fa-plus-circle mr-1"></i> Thêm món đầu tiên
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0">
                    <thead class="thead-light">
                        <tr>
                            <th style="width: 50px;" class="text-center">#</th>
                            <th style="width: 70px;" class="text-center">Hình ảnh</th>
                            <th style="min-width: 160px;">Tên món</th>
                            <th style="width: 140px;">Danh mục</th>
                            <th style="width: 120px;" class="text-right">Giá</th>
                            <th style="width: 110px;" class="text-center">Thời gian chế biến</th>
                            <th style="width: 110px;" class="text-center">Trạng thái</th>
                            <th style="width: 200px;" class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var primaryImg = item.DishImages != null
                                ? (item.DishImages.FirstOrDefault(i => i.IsPrimary) ?? item.DishImages.FirstOrDefault())
                                : null;

                            int orderCount = item.OrderItems != null ? item.OrderItems.Count : 0;
                            int comboCount = item.ComboItems != null ? item.ComboItems.Count : 0;
                            bool isUsed = (orderCount > 0 || comboCount > 0);

                            <tr>
                                <td class="text-center align-middle font-weight-bold text-muted">
                                    @item.Id
                                </td>
                                <td class="text-center align-middle">
                                    @if (primaryImg != null && !string.IsNullOrWhiteSpace(primaryImg.ImageUrl))
                                    {
                                        <img data-food-image src="@Url.Content(RestaurantWebsite.Infrastructure.MenuImages.ResolveDish(item.Name, primaryImg.ImageUrl))"
                                             alt="@item.Name"
                                             class="img-thumbnail rounded"
                                             style="width: 48px; height: 48px; object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <div class="bg-light rounded d-inline-flex align-items-center justify-content-center"
                                             style="width: 48px; height: 48px; border: 1px dashed #ccc;">
                                            <i class="fa fa-cutlery text-muted"></i>
                                        </div>
                                    }
                                </td>
                                <td class="align-middle">
                                    <strong class="text-dark font-weight-bold">@item.Name</strong>
                                    @if (!string.IsNullOrWhiteSpace(item.Description))
                                    {
                                        <small class="d-block text-muted text-truncate" style="max-width: 250px;">
                                            @item.Description
                                        </small>
                                    }
                                </td>
                                <td class="align-middle">
                                    @if (item.Category != null)
                                    {
                                        <span class="badge badge-light border text-dark px-2 py-1">
                                            <i class="fa fa-folder-o mr-1"></i> @item.Category.Name
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="text-right align-middle font-weight-bold text-success">
                                    @item.Price.ToString("N0") VNĐ
                                </td>
                                <td class="text-center align-middle text-muted">
                                    <i class="fa fa-clock-o mr-1"></i> @item.PreparationTime m
                                </td>
                                <td class="text-center align-middle">
                                    @if (item.Status == "Available")
                                    {
                                        <span class="badge badge-success px-2 py-1">
                                            <i class="fa fa-check-circle mr-1"></i> Sẵn sàng
                                        </span>
                                    }
                                    else if (item.Status == "Temporarily Unavailable" || item.Status == "Unavailable")
                                    {
                                        <span class="badge badge-warning text-dark px-2 py-1">
                                            <i class="fa fa-pause-circle mr-1"></i> Tạm ngừng
                                        </span>
                                    }
                                    else if (item.Status == "Discontinued")
                                    {
                                        <span class="badge badge-secondary px-2 py-1">
                                            <i class="fa fa-ban mr-1"></i> Ngừng kinh doanh
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-light border px-2 py-1">
                                            @(Vietnamese.Label(item.Status))
                                        </span>
                                    }
                                </td>
                                <td class="text-center align-middle">
                                    <div class="d-flex justify-content-center align-items-center">
                                        <!-- Edit -->
                                        <a href="@Url.Action("Edit", "Dishes", new { area = Convert.ToString(ViewContext.RouteData.DataTokens["area"]), id = item.Id })"
                                           class="btn btn-outline-primary btn-sm mr-1"
                                           title="Sửa món">
                                            <i class="fa fa-pencil"></i>
                                        </a>

                                        <!-- Toggle Status -->
                                        @using (Html.BeginForm("ToggleStatus", "Dishes", new { area = Convert.ToString(ViewContext.RouteData.DataTokens["area"]), id = item.Id }, FormMethod.Post, new { @class = "d-inline mr-1" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <button type="submit"
                                                    class="btn @(item.Status == "Available" ? "btn-outline-warning" : "btn-outline-success") btn-sm"
                                                    title="@(item.Status == "Available" ? "Tạm ngừng phục vụ (ẩn khỏi thực đơn)" : "Mở bán (hiện trên thực đơn)")"
                                                    onclick="return confirm('Bạn xác nhận thực hiện thao tác này?');">
                                                <i class="fa @(item.Status == "Available" ? "fa-pause" : "fa-play")"></i>
                                            </button>
                                        }

                                        <!-- Delete -->
                                        @if (Convert.ToString(ViewContext.RouteData.DataTokens["area"]) == "Admin" && Convert.ToString(Session["Role"]) == "Admin")
                                        {
                                        using (Html.BeginForm("Delete", "Dishes", new { area = Convert.ToString(ViewContext.RouteData.DataTokens["area"]), id = item.Id }, FormMethod.Post, new { @class = "d-inline" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            if (isUsed)
                                             {
                                                <button type="button"
                                                        class="btn btn-outline-danger btn-sm"
                                                        title="Món đang được tham chiếu. Hãy tạm ngừng phục vụ hoặc ngừng kinh doanh."
                                                        onclick="alert('Dữ liệu đang được sử dụng. Hãy ngừng hoạt động thay vì xóa.');">
                                                    <i class="fa fa-trash-o"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit"
                                                        class="btn btn-outline-danger btn-sm"
                                                        title="Xóa món"
                                                        onclick="return confirm('Bạn xác nhận thực hiện thao tác này?');">
                                                    <i class="fa fa-trash-o"></i>
                                                </button>
                                            }
                                        }
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="card-footer bg-light d-flex justify-content-between align-items-center">
            <span class="text-muted small">
                Đang hiển thị <strong>@totalCount</strong> món (@availableCount đang phục vụ, @unavailableCount ngừng phục vụ)
            </span>
            <a href="@Url.Action("Create", "Dishes", new { area = Convert.ToString(ViewContext.RouteData.DataTokens["area"]) })" class="btn btn-success btn-sm">
                <i class="fa fa-plus-circle mr-1"></i> Thêm món
            </a>
        </div>
    }
</div>
