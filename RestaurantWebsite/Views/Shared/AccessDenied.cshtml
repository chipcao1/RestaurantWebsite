@{
    ViewBag.Title = "Không có quyền truy cập";
    ViewBag.BodyClass = "sub_page";
}

<section class="layout_padding">
    <div class="container">

        <div class="text-center">

            <div style="font-size: 80px; color: #dc3545;">
                <i class="fa fa-lock"></i>
            </div>

            <h2 class="mt-3">Không có quyền truy cập</h2>

            <p class="text-muted mt-3">
                Bạn không có quyền truy cập trang này.
            </p>

            <div class="alert alert-danger mt-4">
                Vai trò hiện tại của bạn không được truy cập khu vực này.
            </div>

            <a href="@Url.Action("Login", "Account", new { area = "" })" class="btn btn-warning text-white mr-2">
                <i class="fa fa-sign-in mr-1"></i>
                Đăng nhập bằng tài khoản khác
            </a>

            @if (Session["Role"] != null)
            {
                string role = Session["Role"].ToString();

                if (string.Equals(role, "Customer", System.StringComparison.OrdinalIgnoreCase))
                {
                    <a href="@Url.RouteUrl("CustomerHome")" class="btn btn-outline-secondary">
                        Đến trang khách hàng
                    </a>
                }
                else if (string.Equals(role, "Staff", System.StringComparison.OrdinalIgnoreCase))
                {
                    <a href="@Url.RouteUrl("StaffHome")" class="btn btn-outline-secondary">
                        Đến trang nhân viên
                    </a>
                }
                else if (string.Equals(role, "Admin", System.StringComparison.OrdinalIgnoreCase))
                {
                    <a href="@Url.RouteUrl("AdminHome")" class="btn btn-outline-secondary">
                        Đến trang quản trị
                    </a>
                }
            }

        </div>

    </div>
</section>
