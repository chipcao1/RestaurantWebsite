@model RestaurantWebsite.Models.User

@{
    ViewBag.Title = "My Profile";
    ViewBag.BodyClass = "sub_page";
}

<section class="layout_padding">
    <div class="container">
        <div class="heading_container heading_center">
            <h2>My Profile</h2>
        </div>

        @if (TempData["ProfileSuccess"] != null)
        {
            <div class="alert alert-success mt-4">
                @TempData["ProfileSuccess"]
            </div>
        }

        <div class="row mt-4">
            <div class="col-md-8 mx-auto">
                @using (Html.BeginForm("Profile", "Account", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()

                    <div class="form-group">
                        <label>Full Name</label>
                        @Html.TextBoxFor(m => m.FullName, new { @class = "form-control", maxlength = "100" })
                        @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger" })
                    </div>

                    <div class="form-group">
                        <label>Email</label>
                        @Html.TextBoxFor(m => m.Email, new { @class = "form-control", @readonly = "readonly" })
                    </div>

                    <div class="form-group">
                        <label>Phone</label>
                        @Html.TextBoxFor(m => m.Phone, new { @class = "form-control", maxlength = "20" })
                    </div>

                    <div class="form-group">
                        <label>Address</label>
                        @Html.TextAreaFor(m => m.Address, new { @class = "form-control", rows = "3", maxlength = "250" })
                    </div>

                    <button type="submit" class="btn btn-warning text-white">
                        <i class="fa fa-save mr-1"></i> Save Changes
                    </button>

                    <a href="@Url.Action("ChangePassword", "Account")" class="btn btn-outline-secondary ml-2">
                        Change Password
                    </a>
                }
            </div>
        </div>

        <div class="row mt-4 justify-content-center">
            <div class="col-md-3 mb-2">
                <a href="@Url.Action("MyOrders", "Account")" class="btn btn-outline-warning btn-block">My Orders</a>
            </div>
            <div class="col-md-3 mb-2">
                <a href="@Url.Action("MyReservations", "Account")" class="btn btn-outline-warning btn-block">My Reservations</a>
            </div>
            <div class="col-md-3 mb-2">
                <a href="@Url.Action("MyReviews", "Account")" class="btn btn-outline-warning btn-block">My Reviews</a>
            </div>
        </div>
    </div>
</section>
