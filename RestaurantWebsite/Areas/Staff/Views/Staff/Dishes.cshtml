@using RestaurantWebsite.Infrastructure
@using RestaurantWebsite.Services
@model IEnumerable<RestaurantWebsite.Models.Dish>

@{
    ViewBag.Title = "Tình trạng món ăn";
    Layout = "~/Views/Shared/_OperationsLayout.cshtml";
}

<div class="card card-primary card-outline">
    <div class="card-header">
        <h3 class="card-title font-weight-bold"><i class="fa fa-cutlery mr-2"></i>Tình trạng phục vụ món ăn</h3>
        <div class="card-tools">
            <span class="badge badge-info">Không gian làm việc</span>
        </div>
    </div>

    <div class="card-body">
        <!-- Search & Category Filter Form -->
        @using (Html.BeginForm("Index", "Dishes", new { area = "Staff" }, FormMethod.Get, new { @class = "form-inline mb-4" }))
        {
            <div class="form-group mr-2 mb-2">
                <label class="mr-2 font-weight-bold">Danh mục:</label>
                @Html.DropDownList("categoryId", (SelectList)ViewBag.Categories, "Tất cả danh mục", new { @class = "form-control form-control-sm", onchange = "this.form.submit()" })
            </div>

            <div class="form-group mr-2 mb-2">
                <div class="input-group input-group-sm">
                    <input type="text" name="search" class="form-control" placeholder="Tên món..." value="@ViewBag.SearchTerm" />
                    <div class="input-group-append">
                        <button type="submit" class="btn btn-default">
                            <i class="fa fa-search"></i>
                        </button>
                    </div>
                </div>
            </div>

            if (!string.IsNullOrEmpty(ViewBag.SearchTerm) || !string.IsNullOrEmpty(ViewBag.SelectedCategory))
            {
                <a href="@Url.Action("Index", "Dishes", new { area = "Staff" })" class="btn btn-outline-secondary btn-sm mb-2 ml-1">
                    <i class="fa fa-times"></i> Xóa bộ lọc
                </a>
            }
        }

        <!-- Dishes Table -->
        @if (!Model.Any())
        {
            <div class="alert alert-info text-center my-4">
                <i class="fa fa-info-circle fa-2x d-block mb-2"></i>
                <h5>Không tìm thấy món phù hợp.</h5>
                <p class="mb-0">Hãy xóa bộ lọc và thử lại.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-bordered table-hover table-striped align-middle">
                    <thead class="thead-dark">
                        <tr>
                            <th style="width: 50px;" class="text-center">#ID</th>
                            <th>Tên món</th>
                            <th>Danh mục</th>
                            <th class="text-right">Giá</th>
                            <th class="text-center">Thời gian chế biến</th>
                            <th class="text-center">Tình trạng phục vụ</th>
                            <th style="width: 170px;" class="text-center">Đổi nhanh trạng thái</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var dish in Model)
                        {
                            bool isAvailable = dish.Status == "Available";
                            <tr>
                                <td class="text-center font-weight-bold">#@dish.Id</td>
                                <td>
                                    <span class="font-weight-bold">@dish.Name</span>
                                    @if (!string.IsNullOrEmpty(dish.Description))
                                    {
                                        <small class="text-muted d-block text-truncate" style="max-width: 250px;">@dish.Description</small>
                                    }
                                </td>
                                <td>
                                    <span class="badge badge-light border">@(dish.Category != null ? dish.Category.Name : "Chưa phân loại")</span>
                                </td>
                                <td class="text-right font-weight-bold text-success">@Vietnamese.Money(dish.Price)</td>
                                <td class="text-center"><i class="fa fa-clock-o text-muted mr-1"></i>@dish.PreparationTime phút</td>
                                <td class="text-center">
                                    @if (isAvailable)
                                    {
                                        <span class="badge badge-success px-2 py-1"><i class="fa fa-check mr-1"></i>Sẵn sàng</span>
                                    }
                                    else if (dish.Status == "Discontinued")
                                    {
                                        <span class="badge badge-secondary px-2 py-1"><i class="fa fa-ban mr-1"></i>Ngừng kinh doanh</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-warning text-dark px-2 py-1"><i class="fa fa-pause mr-1"></i>Tạm ngừng phục vụ</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (DishAvailabilityRules.CanToggle(dish.Status))
                                    {
                                        using (Html.BeginForm("ToggleStatus", "Dishes", new { area = "Staff", id = dish.Id, categoryId = ViewBag.SelectedCategory, search = ViewBag.SearchTerm }, FormMethod.Post, new { style = "display:inline;" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm @(isAvailable ? "btn-outline-danger" : "btn-outline-success")"
                                                    title="@(isAvailable ? "Tạm ngừng phục vụ" : "Mở phục vụ")">
                                                <i class="fa @(isAvailable ? "fa-toggle-on" : "fa-toggle-off") mr-1"></i>
                                                @(isAvailable ? "Tạm ngừng phục vụ" : "Mở phục vụ")
                                            </button>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Không còn phục vụ</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
