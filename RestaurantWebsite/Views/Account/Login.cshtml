@{
    ViewBag.Title = "Đăng nhập";
    ViewBag.BodyClass = "sub_page";
    var returnUrl = ViewBag.ReturnUrl as string;
}

<section class="food_section layout_padding">

    <div class="container">

        <div class="heading_container heading_center mb-4">
            <h2>Đăng nhập</h2>
        </div>

        <div class="row justify-content-center">

            <div class="col-md-6 col-lg-5">

                <div class="bg-white p-4 rounded shadow-sm">



                    @if (!ViewData.ModelState.IsValid)
                    {
                        @Html.ValidationSummary(
                            true,
                            "Please check the information below.",
                            new { @class = "alert alert-danger" })
                    }

                    @using (Html.BeginForm("Login", "Account", new { area = "" }, FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="returnUrl"
                               value="@returnUrl" />

                        <div class="form-group">
                            <label for="Email" class="font-weight-bold">
                                Email
                            </label>

                            <input type="email"
                                   id="Email"
                                   name="email"
                                   class="form-control"
                                   maxlength="150"
                                   value="@Request.Form["email"]"
                                   placeholder="Nhập email của bạn"
                                   required />
                        </div>

                        <div class="form-group">
                            <label for="Password" class="font-weight-bold">
                                Mật khẩu
                            </label>

                            <input type="password"
                                   id="Password"
                                   name="password"
                                   class="form-control"
                                   placeholder="Nhập mật khẩu"
                                   required />
                        </div>

                        <button type="submit"
                                class="btn btn-warning text-white btn-block font-weight-bold">
                            Đăng nhập
                        </button>
                    }

                    <div class="text-center mt-3">
                        <span class="text-muted">Bạn chưa có tài khoản?</span>
                        <a href="@Url.Action("Register", "Account", new { area = "" })">
                            Đăng ký
                        </a>
                    </div>

                </div>

            </div>

        </div>

    </div>

</section>
