@using System.Linq
@using RestaurantWebsite.Models
@using RestaurantWebsite.Infrastructure
@model RestaurantWebsite.ViewModels.MenuCatalogViewModel
@{ViewBag.Title="Bữa ngon cho những cuộc gặp gỡ";ViewBag.BodyClass="home_page";var combo=Model.Combos.FirstOrDefault();}
@section Hero {
<section class="slider_section">
    <div class="container">
        <div class="row">
            <div class="col-md-7 col-lg-6">
                <div class="detail-box">
                    <span class="section-kicker">CHÀO MỪNG ĐẾN FEANE</span>
                    <h1>Bữa ăn ngon bắt đầu từ sự tận tâm</h1>
                    <p>Khám phá món ngon được chuẩn bị từ nguyên liệu tươi mới. Dùng bữa tại nhà hàng, mang về hoặc nhận giao tận nơi.</p>
                    <div class="btn-box">
                        <a href="@Url.Action("Index", "Menu", new { area = "Customer" })">Khám phá thực đơn</a>
                        <a class="hero-secondary" href="@Url.Action("Index", "Reservation", new { area = "Customer" })">Đặt bàn trước</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
}
@Html.Partial("~/Views/Shared/_MenuCatalog.cshtml", Model)
@if(combo!=null){<section class="layout_padding" style="background:#222831;color:white">
<div class="container">
<div class="row align-items-center">
<div class="col-md-7">
<p class="section-kicker">CÙNG NHAU THƯỞNG THỨC</p>
<h2>@combo.Name</h2>
<p>@combo.Description</p>
<strong>@Vietnamese.Money(combo.Price)</strong>
</div>
<div class="col-md-5 text-md-right mt-3">
<a class="btn btn-warning" href="@Url.Action("Index", "Menu",new{area="Customer"})">Khám phá suất ăn kết hợp</a>
</div>
</div>
</div>
</section>}
<section class="layout_padding">
<div class="container">
<div class="page-heading">
<div>
<p class="eyebrow">DÀNH CHỖ CHO NIỀM VUI</p>
<h2>Hẹn nhau ở Feane</h2>
<p>Chọn ngày giờ, số khách và bàn phù hợp. Chúng tôi sẽ xác nhận để bạn yên tâm ghé thăm.</p>
</div>
<a class="btn btn-warning" href="@Url.Action("Index", "Reservation",new{area="Customer"})">Đặt bàn ngay</a>
</div>
</div>
</section>

@section scripts {
    <script src="@Url.Content("~/Scripts/menu-catalog.js")"></script>
}
