@model RestaurantWebsite.Models.Category
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewBag.Title = "Edit Category - " + Model.Name;

    int dishCount = Model.Dishes != null ? Model.Dishes.Count : 0;
}

<div class="row justify-content-center">
    <div class="col-lg-8 col-md-10 col-12">
        <div class="card card-info card-outline shadow-sm">
            <div class="card-header">
                <h3 class="card-title font-weight-bold">
                    <i class="fa fa-pencil text-info mr-1"></i> Edit Category: <strong>@Model.Name</strong>
                </h3>
                <div class="card-tools">
                    <a href="@Url.Action("Index", "Category")" class="btn btn-outline-secondary btn-sm">
                        <i class="fa fa-arrow-left mr-1"></i> Back to List
                    </a>
                </div>
            </div>

            @using (Html.BeginForm("Edit", "Category", FormMethod.Post, new { @class = "form-horizontal" }))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.Id)

                <div class="card-body">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <h5><i class="fa fa-exclamation-triangle mr-2"></i> Please correct the following errors:</h5>
                            @Html.ValidationSummary(false, "", new { @class = "mb-0 pl-3 text-white" })
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">&times;</span>
                            </button>
                        </div>
                    }

                    <!-- Linked Dishes Info Callout -->
                    @if (dishCount > 0)
                    {
                        <div class="callout callout-info py-2 mb-3 bg-light">
                            <i class="fa fa-info-circle text-info mr-1"></i>
                            This category currently contains <strong>@dishCount</strong> dish(es).
                            Changing status to <em>Inactive</em> will hide this category from the customer menu while preserving all dish records.
                        </div>
                    }

                    <!-- Category ID (Display only) -->
                    <div class="form-group row">
                        <label class="col-sm-3 col-form-label text-muted">
                            Category ID
                        </label>
                        <div class="col-sm-9 d-flex align-items-center">
                            <span class="badge badge-light border px-3 py-2 font-weight-bold">#@Model.Id</span>
                        </div>
                    </div>

                    <!-- Category Name -->
                    <div class="form-group row">
                        <label for="Name" class="col-sm-3 col-form-label font-weight-bold">
                            Category Name <span class="text-danger">*</span>
                        </label>
                        <div class="col-sm-9">
                            @Html.TextBoxFor(m => m.Name, new {
                                @class = "form-control",
                                placeholder = "e.g. Appetizers, Main Dishes, Drinks...",
                                maxlength = "100",
                                required = "required"
                            })
                            @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger small" })
                        </div>
                    </div>

                    <!-- Description -->
                    <div class="form-group row">
                        <label for="Description" class="col-sm-3 col-form-label font-weight-bold">
                            Description
                        </label>
                        <div class="col-sm-9">
                            @Html.TextAreaFor(m => m.Description, new {
                                @class = "form-control",
                                rows = "3",
                                placeholder = "Brief description of dishes in this category...",
                                maxlength = "500"
                            })
                            @Html.ValidationMessageFor(m => m.Description, "", new { @class = "text-danger small" })
                        </div>
                    </div>

                    <!-- Image URL -->
                    <div class="form-group row">
                        <label for="ImageUrl" class="col-sm-3 col-form-label font-weight-bold">
                            Image Path / URL
                        </label>
                        <div class="col-sm-9">
                            @Html.TextBoxFor(m => m.ImageUrl, new {
                                @class = "form-control",
                                id = "categoryImageUrl",
                                placeholder = "e.g. /Content/images/categories/appetizers.jpg or https://...",
                                maxlength = "250"
                            })
                            @Html.ValidationMessageFor(m => m.ImageUrl, "", new { @class = "text-danger small" })

                            <!-- Live preview block -->
                            <div class="mt-2 d-flex align-items-center" id="imagePreviewContainer">
                                <span class="mr-2 small text-muted">Preview:</span>
                                <img id="previewImg"
                                     src="@(string.IsNullOrWhiteSpace(Model.ImageUrl) ? Url.Content("~/Resources/Admin/img/default-150x150.png") : Url.Content(Model.ImageUrl))"
                                     alt="Preview"
                                     class="img-thumbnail rounded"
                                     style="width: 60px; height: 60px; object-fit: cover;"
                                     onerror="this.src='@Url.Content("~/Resources/Admin/img/default-150x150.png")';" />
                            </div>
                        </div>
                    </div>

                    <!-- IsActive -->
                    <div class="form-group row align-items-center">
                        <label class="col-sm-3 col-form-label font-weight-bold">
                            Visibility Status
                        </label>
                        <div class="col-sm-9">
                            <div class="custom-control custom-checkbox">
                                @Html.CheckBoxFor(m => m.IsActive, new { @class = "custom-control-input", id = "isActiveCheck" })
                                <label class="custom-control-label font-weight-normal" for="isActiveCheck">
                                    <strong>Active</strong> (Category is visible on the customer menu and homepage)
                                </label>
                            </div>
                        </div>
                    </div>

                </div>

                <div class="card-footer bg-light d-flex justify-content-between">
                    <a href="@Url.Action("Index", "Category")" class="btn btn-default">
                        <i class="fa fa-times mr-1"></i> Cancel
                    </a>
                    <button type="submit" class="btn btn-primary font-weight-bold px-4">
                        <i class="fa fa-check mr-1"></i> Update Category
                    </button>
                </div>
            }
        </div>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function () {
            var $imgInput = $('#categoryImageUrl');
            var $preview = $('#previewImg');

            function updatePreview() {
                var val = $imgInput.val().trim();
                if (val) {
                    $preview.attr('src', val);
                } else {
                    $preview.attr('src', '@Url.Content("~/Resources/Admin/img/default-150x150.png")');
                }
            }

            $imgInput.on('input change blur', updatePreview);
        });
    </script>
}
