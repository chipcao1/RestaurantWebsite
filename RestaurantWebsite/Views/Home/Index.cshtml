@using System.Linq
@using RestaurantWebsite.Models
@using RestaurantWebsite.Infrastructure
@{ViewBag.Title="Bữa ngon cho những cuộc gặp gỡ";var dishes=ViewBag.HomeDishes as IEnumerable<Dish>??new List<Dish>();var categories=ViewBag.HomeCategories as IEnumerable<Category>??new List<Category>();var combo=ViewBag.HomeCombo as Combo;}
@section Hero {<section class="container">
<div class="customer-hero">
<span class="section-kicker">BẾP ẤM · MÓN NGON · KHOẢNH KHẮC ĐẸP</span>
<h1>Một bữa ngon.<br/>Nhiều điều đáng nhớ.</h1>
<p>Từ bữa trưa nhẹ nhàng đến buổi tối sum vầy, Feane chuẩn bị từng món ăn để bạn tận hưởng khoảng thời gian bên những người thân yêu.</p>
<div class="hero-actions">
<a class="btn btn-warning" href="@Url.Action("Index", "Menu",new{area="Customer"})">Khám phá thực đơn <i class="fa fa-arrow-right">
</i>
</a>
<a class="btn btn-outline-light" href="@Url.Action("Index", "Reservation",new{area="Customer"})">Đặt bàn trước</a>
</div>
</div>
</section>}
<section class="food_section layout_padding">
<div class="container">
<div class="page-heading">
<div>
<p class="eyebrow">TỪ CĂN BẾP FEANE</p>
<h2>Món ngon cho hôm nay</h2>
<p>Chọn món yêu thích, dùng tại bàn, mang về hoặc nhận giao tận nơi.</p>
</div>
<a href="@Url.Action("Index", "Menu",new{area="Customer"})" class="btn btn-outline-dark">Xem toàn bộ thực đơn</a>
</div>
<div class="account-nav">@foreach(var category in categories){<a href="@Url.Action("Index", "Menu",new{area="Customer",categoryId=category.Id})">@category.Name</a>}</div>
<div class="row grid">
@foreach(var dish in dishes){var image=dish.DishImages.FirstOrDefault(i=>i.IsPrimary)??dish.DishImages.FirstOrDefault();<div class="col-sm-6 col-lg-4 mb-4">
<div class="box">
<div class="img-box">
<img src="@(image==null?Url.Content("~/Resources/User/images/f1.png"):Url.Content(image.ImageUrl))" alt="@dish.Name" loading="lazy"/>
</div>
<div class="detail-box">
<h3>@dish.Name</h3>
<p>@dish.Description</p>
<div class="d-flex align-items-center justify-content-between">
<strong>@Vietnamese.Money(dish.Price)</strong>
<a href="@Url.Action("Index", "Menu",new{area="Customer",search=dish.Name})" class="btn btn-warning btn-sm">Chọn món</a>
</div>
</div>
</div>
</div>}
</div>@if(!dishes.Any()){<p class="empty-state">Nhà hàng đang cập nhật thực đơn. Vui lòng quay lại sau.</p>}</div>
</section>
@if(combo!=null){<section class="layout_padding" style="background:#253229;color:white">
<div class="container">
<div class="row align-items-center">
<div class="col-md-7">
<p class="section-kicker">CÙNG NHAU THƯỞNG THỨC</p>
<h2>@combo.Name</h2>
<p>@combo.Description</p>
<strong>@Vietnamese.Money(combo.Price)</strong>
</div>
<div class="col-md-5 text-md-right mt-3">
<a class="btn btn-warning" href="@Url.Action("Index", "Menu",new{area="Customer"})">Khám phá suất ăn kết hợp</a>
</div>
</div>
</div>
</section>}
<section class="layout_padding">
<div class="container">
<div class="page-heading">
<div>
<p class="eyebrow">DÀNH CHỖ CHO NIỀM VUI</p>
<h2>Hẹn nhau ở Feane</h2>
<p>Chọn ngày giờ, số khách và bàn phù hợp. Chúng tôi sẽ xác nhận để bạn yên tâm ghé thăm.</p>
</div>
<a class="btn btn-warning" href="@Url.Action("Index", "Reservation",new{area="Customer"})">Đặt bàn ngay</a>
</div>
</div>
</section>
