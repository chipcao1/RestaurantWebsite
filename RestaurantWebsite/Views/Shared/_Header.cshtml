@{string role=Convert.ToString(Session["Role"]);bool logged=Session["UserId"]!=null;}
<header class="header_section">
<div class="container">
<nav class="navbar navbar-expand-lg custom_nav-container">
<a class="navbar-brand" href="@Url.Action("Index", "Home",new{area=""})">
<span>Feane</span>
</a>
<button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Mở hoặc đóng menu">
<span>
</span>
</button>
<div class="collapse navbar-collapse" id="navbarSupportedContent">
<ul class="navbar-nav mx-auto">
<li class="nav-item">
<a class="nav-link" href="@Url.Action("Index", "Home",new{area=""})">Trang chủ</a>
</li>
<li class="nav-item">
<a class="nav-link" href="@Url.Action("Index", "Menu",new{area="Customer"})">Thực đơn</a>
</li>
<li class="nav-item">
<a class="nav-link" href="@Url.Action("About", "Home",new{area=""})">Về nhà hàng</a>
</li>
<li class="nav-item">
<a class="nav-link" href="@Url.Action("Index", "Reservation",new{area="Customer"})">Đặt bàn</a>
</li>
@if(role=="Admin"){<li class="nav-item">
<a class="nav-link" href="@Url.RouteUrl("AdminHome")">Quản trị</a>
</li>}else if(role=="Staff"){<li class="nav-item">
<a class="nav-link" href="@Url.RouteUrl("StaffHome")">Nhân viên</a>
</li>}
</ul>
<div class="user_option">
<a href="@Url.RouteUrl("CustomerCart")" class="cart_link" aria-label="Giỏ hàng">
<i class="fa fa-shopping-bag">
</i>
</a>
@if(logged){<div class="dropdown">
<button class="btn text-white dropdown-toggle" type="button" id="accountMenu" aria-haspopup="true" aria-expanded="false">@Session["UserName"]</button>
<div class="dropdown-menu dropdown-menu-right" aria-labelledby="accountMenu">@if(role=="Customer"){<a class="dropdown-item" href="@Url.RouteUrl("CustomerProfile")">Hồ sơ cá nhân</a>
<a class="dropdown-item" href="@Url.RouteUrl("CustomerOrders")">Đơn hàng của tôi</a>
<a class="dropdown-item" href="@Url.RouteUrl("CustomerReservations")">Lịch đặt bàn</a>
<a class="dropdown-item" href="@Url.RouteUrl("CustomerReviews")">Đánh giá của tôi</a>
<a class="dropdown-item" href="@Url.RouteUrl("CustomerChangePassword")">Đổi mật khẩu</a>}@using(Html.BeginForm("Logout", "Account",new{area=""},FormMethod.Post,null)){@Html.AntiForgeryToken()<button class="dropdown-item">Đăng xuất</button>}</div>
</div>}
else{<a class="order_online" href="@Url.Action("Login", "Account",new{area=""})">Đăng nhập</a>}
</div>
</div>
</nav>
</div>
</header>
